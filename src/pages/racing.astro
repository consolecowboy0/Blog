---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource-variable/jetbrains-mono';

const socialImage = new URL('/og.png', Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Falcon is the AI race engineer built around racing geometry. See the line, understand each corner, and find the time."
    />
    <meta property="og:title" content="Falcon | The faster lap has a shape." />
    <meta
      property="og:description"
      content="Live coaching and useful race debriefs for sim racers. Token-based pricing with no subscription."
    />
    <meta property="og:image" content={socialImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Falcon | The faster lap has a shape." />
    <meta
      name="twitter:description"
      content="Live coaching and useful race debriefs for sim racers. Token-based pricing with no subscription."
    />
    <meta name="twitter:image" content={socialImage} />
    <title>Falcon | Geometry-powered AI race engineer</title>
    <link rel="icon" type="image/png" href="/falcon-favicon.png?v=6" />
    <script is:inline src="/beacon.js"></script>
  </head>
  <body>
    <header class="nav-shell">
      <nav aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="Falcon home">
          <img src="/images/falcon-mark.png?v=6" width="34" height="34" alt="" />
          <span>FALCON</span>
        </a>
        <div class="nav-links">
          <a href="#product">Product</a>
          <a href="#pricing">Pricing</a>
          <a href="#early-access" class="nav-cta">Get early access</a>
        </div>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> AI RACE ENGINEER FOR SIM RACERS</p>
          <h1>The faster lap<br />has a <em>shape.</em></h1>
          <p class="lede">
            <strong>Falcons hunt with geometry. Drivers find time the same way.</strong>
            Falcon studies the line, braking, rotation, and exit of every corner,
            then turns the data into something useful for the next lap.
          </p>
          <div class="actions">
            <a class="button primary" href="#early-access">Join early access <span>↘</span></a>
            <a class="button secondary" href="#product">See the geometry</a>
          </div>
          <div class="price-note">
            <strong>Token-based pricing</strong>
            <span>Use credits only when Falcon coaches or analyzes.</span>
          </div>
        </div>

        <div class="product-window" aria-label="Example Falcon race geometry interface">
          <div class="window-top">
            <div class="window-brand">
              <span class="signal-dot"></span>
              FALCON / SESSION 04
            </div>
            <span class="live-label">LIVE</span>
          </div>

          <div class="session-grid">
            <div class="track-map" aria-hidden="true">
              <span class="track-line line-one"></span>
              <span class="track-line line-two"></span>
              <span class="track-line line-three"></span>
              <span class="car-dot"></span>
              <span class="turn-label">T4</span>
            </div>
            <div class="session-stats">
              <div>
                <span>BEST LAP</span>
                <strong>1:42.816</strong>
              </div>
              <div>
                <span>CURRENT DELTA</span>
                <strong class="gain">-0.382</strong>
              </div>
              <div>
                <span>POSITION</span>
                <strong>P06</strong>
              </div>
            </div>
          </div>

          <div class="engineer-message">
            <div class="message-mark">F</div>
            <div>
              <span>LIVE COACH / TURN 4</span>
              <p>You are braking eight meters early. Hold fourth and let the car rotate.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="proof-strip" aria-label="Geometry analyzed by Falcon">
        <span><strong>01</strong> Racing line</span>
        <span><strong>02</strong> Braking point</span>
        <span><strong>03</strong> Rotation and radius</span>
        <span><strong>04</strong> Exit trajectory</span>
      </section>

      <section class="manifesto" id="product">
        <p class="section-label">HOW TIME IS FOUND</p>
        <div class="manifesto-grid">
          <h2>See the lap<br />more clearly.</h2>
          <p>
            Speed lives in the relationship between braking point, radius, rotation,
            and exit. Falcon translates those relationships into a few useful
            observations, without handing you another wall of graphs.
          </p>
        </div>
      </section>

      <section class="debrief" aria-label="Example post-race debrief">
        <div class="debrief-head">
          <div>
            <p class="section-label">POST-RACE DEBRIEF</p>
            <h3>Road Atlanta · GT4</h3>
          </div>
          <div class="session-score">
            <span>SESSION GAIN</span>
            <strong>-1.24s</strong>
          </div>
        </div>

        <div class="lap-chart" aria-label="Lap time improved over six laps">
          <div class="chart-labels">
            <span>1:45</span>
            <span>1:44</span>
            <span>1:43</span>
            <span>1:42</span>
          </div>
          <div class="chart-area">
            <span class="grid-line grid-a"></span>
            <span class="grid-line grid-b"></span>
            <span class="grid-line grid-c"></span>
            <div class="bar" style="--height: 35%"><span>L1</span></div>
            <div class="bar" style="--height: 47%"><span>L2</span></div>
            <div class="bar" style="--height: 53%"><span>L3</span></div>
            <div class="bar" style="--height: 70%"><span>L4</span></div>
            <div class="bar" style="--height: 76%"><span>L5</span></div>
            <div class="bar best" style="--height: 91%"><span>L6</span></div>
          </div>
        </div>

        <div class="debrief-cards">
          <article>
            <span class="card-index">01 / BIGGEST GAIN</span>
            <strong>Turn 10A braking</strong>
            <p>You gained 0.41s by moving the brake point forward and releasing more smoothly.</p>
          </article>
          <article>
            <span class="card-index">02 / NEXT TARGET</span>
            <strong>Turn 5 minimum speed</strong>
            <p>You are giving up 0.28s at apex. Carry 4 km/h more and delay the upshift.</p>
          </article>
          <article>
            <span class="card-index">03 / CONSISTENCY</span>
            <strong>Six clean laps</strong>
            <p>Your final three laps were within 0.19s. The pace is starting to stick.</p>
          </article>
        </div>
      </section>

      <section class="workflow">
        <p class="section-label">HOW FALCON WORKS</p>
        <div class="workflow-grid">
          <article>
            <span>01</span>
            <h3>Measure</h3>
            <p>Falcon reads the session quietly in the background. No exports. No spreadsheet ritual.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Understand</h3>
            <p>It translates inputs and telemetry into the line, radius, rotation, and exit that shaped the lap.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Improve</h3>
            <p>Leave with a clearer picture of the faster lap and one concrete target for the next run.</p>
          </article>
        </div>
      </section>

      <section class="feature-band">
        <div class="feature-intro">
          <p class="section-label">GUIDANCE, NOT NOISE</p>
          <h2>Clear enough to use. Quiet enough to race.</h2>
        </div>
        <div class="feature-list">
          <article>
            <span class="feature-number">01</span>
            <div>
              <h3>Useful live coaching</h3>
              <p>Timely cues for braking, pace, traffic, fuel, and the fight around you.</p>
            </div>
          </article>
          <article>
            <span class="feature-number">02</span>
            <div>
              <h3>Personalized debriefs</h3>
              <p>Falcon learns your habits and stops repeating advice you already fixed.</p>
            </div>
          </article>
          <article>
            <span class="feature-number">03</span>
            <div>
              <h3>Coach on your terms</h3>
              <p>Set the voice, frequency, detail, and moments when Falcon should stay out of the way.</p>
            </div>
          </article>
          <article>
            <span class="feature-number">04</span>
            <div>
              <h3>No expensive commitment</h3>
              <p>Start with included credits. Top up only when you want more coaching.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="pricing" id="pricing">
        <div class="pricing-head">
          <p class="section-label">USAGE-BASED PRICING</p>
          <h2>Pay for coaching.<br />Not another subscription.</h2>
          <p>Falcon uses credits. Start with some included, then buy more only when you need them.</p>
        </div>

        <div class="pricing-grid">
          <article class="price-card">
            <div>
              <span class="plan">SHAKEDOWN</span>
              <div class="price"><strong>Free</strong><span>included credits</span></div>
              <p>Enough credits to see what Falcon finds in your driving.</p>
            </div>
            <ul>
              <li>No payment method to start</li>
              <li>Lap and sector analysis</li>
              <li>One next-session goal</li>
            </ul>
            <a href="#early-access">Get launch credits</a>
          </article>

          <article class="price-card featured">
            <div class="popular">USAGE BASED</div>
            <div>
              <span class="plan">DRIVER CREDITS</span>
              <div class="price"><strong>Top up</strong><span>when you choose</span></div>
              <p>Buy a credit pack. Spend it on the coaching you actually use.</p>
            </div>
            <ul>
              <li>Live voice coaching uses credits</li>
              <li>Post-race debriefs use credits</li>
              <li>Personalized drills and goals included</li>
              <li>No recurring charge</li>
            </ul>
            <a href="#early-access">Join early access</a>
          </article>

          <article class="price-card">
            <div>
              <span class="plan">CREW WALLET</span>
              <div class="price"><strong>Pool</strong><span>shared credits</span></div>
              <p>One shared credit balance for leagues, friends, and small teams.</p>
            </div>
            <ul>
              <li>Up to 3 drivers</li>
              <li>Shared session comparison</li>
              <li>Team improvement board</li>
              <li>One balance to manage</li>
            </ul>
            <a href="#early-access">Bring the crew</a>
          </article>
        </div>

        <p class="pricing-footnote">No subscription. No annual contract. Token pack sizes launch with early access.</p>
      </section>

      <section class="early-access" id="early-access">
        <div>
          <p class="section-label">EARLY ACCESS</p>
          <h2>Be there for<br />the formation lap.</h2>
          <p>
            Falcon starts with iRacing on Windows. Join the list for build updates,
            launch credits, and the first driver invites.
          </p>
        </div>

        <form class="access-form" id="falcon-access-form">
          <label for="falcon-email">Email address</label>
          <div class="form-row">
            <input
              id="falcon-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="driver@example.com"
              required
            />
            <button type="submit">Join early access</button>
          </div>
          <p class="form-note">Only Falcon updates. No spam. Unsubscribe anytime.</p>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <footer>
      <a class="footer-brand" href="#top">
        <img src="/images/falcon-mark.png?v=6" width="26" height="26" alt="" />
        <span>FALCON</span>
      </a>
      <span>© {new Date().getFullYear()} Dustin Landers</span>
      <a href="/">dustinlanders.com ↗</a>
    </footer>

    <script is:inline>
      const form = document.querySelector('#falcon-access-form');
      const status = form?.querySelector('.form-status');
      const button = form?.querySelector('button');

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(button instanceof HTMLButtonElement)) return;

        const data = new FormData(form);
        const email = String(data.get('email') || '');
        button.disabled = true;
        button.textContent = 'Joining...';
        if (status) status.textContent = '';

        try {
          const response = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'falcon' }),
          });

          if (!response.ok) throw new Error('request failed');
          form.reset();
          if (status) status.textContent = 'You are on the grid. Watch your inbox.';
        } catch {
          if (status) status.textContent = 'Could not join right now. Please try again.';
        } finally {
          button.disabled = false;
          button.textContent = 'Join early access';
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --paper-soft: #f7f8ff;
    --ink: #171627;
    --muted: #66677c;
    --line: rgba(65, 67, 125, 0.16);
    --violet: #7447f5;
    --purple: #9b32e8;
    --blue: #2868f0;
    --cyan: #08a8c7;
    --accent: var(--violet);
    --accent-gradient: linear-gradient(112deg, var(--violet), var(--blue) 58%, var(--cyan));
    --window: #11142a;
    --window-soft: #181c38;
    --mono: 'JetBrains Mono Variable', monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background: var(--paper);
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
  }

  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
  }

  nav,
  main,
  footer {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  nav {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand,
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    border: 0;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand img,
  .footer-brand img {
    display: block;
    margin: 0;
    border: 0;
  }

  .brand-dot {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.7rem;
  }

  .nav-links a {
    border: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .nav-links .nav-cta {
    padding: 0.7rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent-gradient);
    color: var(--paper);
    box-shadow: 0 8px 24px rgba(75, 73, 196, 0.18);
  }

  .hero {
    min-height: calc(100vh - 72px);
    padding: 7.5rem 0 5.5rem;
    display: grid;
    grid-template-columns: minmax(0, 0.93fr) minmax(420px, 0.77fr);
    gap: 5.5rem;
    align-items: center;
  }

  .eyebrow,
  .section-label,
  .window-top,
  .session-stats span,
  .engineer-message span,
  .proof-strip,
  .card-index,
  .workflow-grid > article > span,
  .feature-number,
  .plan,
  .session-score span,
  .popular {
    font-family: var(--mono);
  }

  .eyebrow,
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--muted);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 2.2rem;
    height: 2px;
    border-radius: 999px;
    background: var(--accent-gradient);
  }

  h1 {
    margin-top: 1.6rem;
    font-size: clamp(4.4rem, 8.2vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.077em;
    line-height: 0.86;
  }

  h1 em {
    color: transparent;
    font-style: normal;
    background: var(--accent-gradient);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .lede {
    max-width: 650px;
    margin-top: 2.2rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.65;
  }

  .lede strong {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ink);
    font-weight: 600;
  }

  .actions {
    margin-top: 2.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    min-height: 50px;
    padding: 0.8rem 1.05rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    border: 0;
    background: var(--accent-gradient);
    color: var(--paper);
    box-shadow: 0 12px 32px rgba(75, 73, 196, 0.22);
  }

  .button.primary:hover {
    box-shadow: 0 16px 38px rgba(75, 73, 196, 0.29);
  }

  .button.secondary:hover {
    border-color: rgba(116, 71, 245, 0.35);
    background: var(--paper-soft);
  }

  .price-note {
    margin-top: 1.6rem;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.66rem;
  }

  .price-note strong {
    color: var(--ink);
    font-size: 0.8rem;
  }

  .product-window {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(84, 94, 186, 0.22);
    border-radius: 20px;
    background: var(--window);
    box-shadow: 0 30px 80px rgba(43, 46, 117, 0.22);
    color: #f6f7ff;
  }

  .product-window::before {
    position: absolute;
    top: -8rem;
    right: -8rem;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: rgba(116, 71, 245, 0.24);
    filter: blur(40px);
    content: '';
  }

  .window-top {
    height: 52px;
    padding: 0 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    color: #aeb2a8;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }

  .window-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .signal-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 16px var(--cyan);
    animation: signal 1.8s ease-in-out infinite;
  }

  .live-label {
    color: var(--cyan);
  }

  .session-grid {
    min-height: 335px;
    display: grid;
    grid-template-columns: 1fr 0.82fr;
  }

  .track-map {
    position: relative;
    min-height: 335px;
    border-right: 1px solid rgba(255, 255, 255, 0.13);
    background:
      linear-gradient(rgba(103, 114, 210, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(103, 114, 210, 0.09) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .track-line {
    position: absolute;
    display: block;
    height: 14px;
    border: 3px solid #59639b;
    border-radius: 999px;
    transform-origin: left center;
  }

  .line-one {
    width: 64%;
    top: 25%;
    left: 18%;
    transform: rotate(32deg);
  }

  .line-two {
    width: 56%;
    top: 49%;
    left: 42%;
    transform: rotate(118deg);
  }

  .line-three {
    width: 50%;
    top: 72%;
    left: 20%;
    transform: rotate(-22deg);
  }

  .car-dot {
    position: absolute;
    top: 47%;
    left: 48%;
    width: 13px;
    height: 13px;
    border: 3px solid var(--window);
    border-radius: 50%;
    background: var(--purple);
    box-shadow: 0 0 0 3px var(--purple), 0 0 22px var(--purple);
  }

  .turn-label {
    position: absolute;
    top: calc(47% - 28px);
    left: calc(48% + 18px);
    color: #ced0c9;
    font-family: var(--mono);
    font-size: 0.6rem;
  }

  .session-stats {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
  }

  .session-stats div {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }

  .session-stats div:last-child {
    border-bottom: 0;
  }

  .session-stats span,
  .engineer-message span {
    color: #858b7f;
    font-size: 0.56rem;
    letter-spacing: 0.11em;
  }

  .session-stats strong {
    font-family: var(--mono);
    font-size: clamp(1.25rem, 2vw, 1.85rem);
    font-weight: 500;
  }

  .session-stats .gain {
    color: var(--cyan);
  }

  .engineer-message {
    padding: 1.2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    background: var(--window-soft);
  }

  .message-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: var(--accent-gradient);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .engineer-message p {
    margin-top: 0.45rem;
    color: #e3e5de;
    font-family: var(--mono);
    font-size: 0.69rem;
    line-height: 1.6;
  }

  .proof-strip {
    padding: 1.5rem 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
