---
interface Props {
  type: 'bar' | 'line' | 'pie' | 'doughnut' | 'radar' | 'scatter';
  labels: string[];
  datasets: {
    label: string;
    data: number[];
    backgroundColor?: string | string[];
    borderColor?: string | string[];
    borderWidth?: number;
    fill?: boolean;
    tension?: number;
  }[];
  title?: string;
}

const { type, labels, datasets, title } = Astro.props;
const chartId = `chart-${Math.random().toString(36).slice(2, 9)}`;
const config = JSON.stringify({ type, data: { labels, datasets }, options: {
  responsive: true,
  maintainAspectRatio: true,
  plugins: {
    legend: { labels: { font: { family: 'Inter, sans-serif', size: 13 } } },
    title: title ? { display: true, text: title, font: { family: 'Inter, sans-serif', size: 16, weight: 800 } } : { display: false },
  },
  scales: type !== 'pie' && type !== 'doughnut' && type !== 'radar' ? {
    x: { ticks: { font: { family: 'Inter, sans-serif' } } },
    y: { ticks: { font: { family: 'Inter, sans-serif' } } },
  } : undefined,
}});
---

<div class="chart-container">
  <canvas id={chartId}></canvas>
</div>

<script define:vars={{ chartId, config }}>
  async function initChart() {
    const { Chart, registerables } = await import('chart.js');
    Chart.register(...registerables);
    const ctx = document.getElementById(chartId);
    const parsed = JSON.parse(config);
    const style = getComputedStyle(document.documentElement);
    const fg = style.getPropertyValue('--fg').trim() || '#1a1a1a';
    const muted = style.getPropertyValue('--fg-muted').trim() || '#555';
    const border = style.getPropertyValue('--border').trim() || '#e0e0db';
    if (parsed.options.plugins.legend) parsed.options.plugins.legend.labels.color = fg;
    if (parsed.options.plugins.title?.display) parsed.options.plugins.title.color = fg;
    if (parsed.options.scales) {
      for (const axis of Object.values(parsed.options.scales)) {
        if (axis.ticks) axis.ticks.color = muted;
        if (!axis.grid) axis.grid = {};
        axis.grid.color = border;
      }
    }
    new Chart(ctx, parsed);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChart);
  } else {
    initChart();
  }
</script>
