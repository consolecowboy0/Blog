---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Story Studio - dustinlanders.com">
  <div id="gate">
    <div class="gate-box">
      <div class="gate-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2>Story Studio</h2>
      <p class="gate-sub">Enter password to continue.</p>
      <form id="gate-form">
        <input type="password" id="gate-password" placeholder="Password" autocomplete="off" />
        <button type="submit" id="gate-unlock">Unlock</button>
      </form>
      <p id="gate-error" class="gate-error gate-hidden">Wrong password</p>
    </div>
  </div>

  <section id="panel" style="display: none;">
    <div class="story-header">
      <div>
        <h1>Story Studio</h1>
        <p class="story-tagline">Write characters in text. Drop them into a place. Watch them trade lines, comic-book tight.</p>
      </div>
      <button id="sign-out" class="secondary-btn">Sign Out</button>
    </div>

    <div class="setup-grid">
      <!-- Characters -->
      <section class="block">
        <div class="block-head">
          <h2>Characters</h2>
          <button id="add-char" type="button" class="secondary-btn">+ Add</button>
        </div>
        <div id="char-list" class="char-list"></div>
        <p class="hint">Name and describe each one (voice, temperament, history), then give a private goal: one small, scene-sized thing they want right now. Goals stay secret; characters chase them through subtext, which is what gives a scene friction instead of small talk.</p>
      </section>

      <!-- Setting -->
      <section class="block">
        <div class="block-head"><h2>Situation &amp; place</h2></div>
        <textarea id="setting" class="setting-input" rows="8" placeholder="Where are they, when, and what is happening? e.g. A stalled night train between two cities. The heat is out. Five strangers share one carriage and someone just pulled the emergency brake."></textarea>
        <p class="hint">Sets the stage every character can see. Change it anytime.</p>
      </section>
    </div>

    <!-- Story direction (orchestrator) -->
    <section class="block">
      <div class="block-head"><h2>Story direction</h2></div>
      <textarea id="direction" class="setting-input" rows="4" placeholder="Optional: the shape you want. The arc, the turn, the ending, the theme. e.g. Build to the moment one of them admits they pulled the brake on purpose, then end on the others deciding whether to cover for them."></textarea>
      <p class="hint">The orchestrator is an AI showrunner. Each round it reads this and the scene so far, then drops a short note steering the next beats toward where you want it to go. Toggle it in the run bar below.</p>
    </section>

    <!-- Run controls -->
    <section class="block run-block">
      <div class="run-controls">
        <label class="ctl">Model
          <select id="model-select">
            <option value="claude-sonnet-4-20250514">Sonnet (richer)</option>
            <option value="claude-haiku-4-5-20251001">Haiku (faster)</option>
          </select>
        </label>
        <label class="ctl">Rounds
          <input id="rounds" type="number" min="1" max="20" value="4" />
        </label>
        <label class="ctl">Format
          <select id="format-select">
            <option value="screenplay" selected>Screenplay</option>
            <option value="comic">Comic</option>
          </select>
        </label>
        <label class="ctl">Beat length
          <select id="length-select">
            <option value="120" selected>Tight</option>
            <option value="240">Short</option>
            <option value="450">Long</option>
          </select>
        </label>
        <label class="ctl">Order
          <select id="order-select">
            <option value="fixed">In order</option>
            <option value="random">Shuffle</option>
          </select>
        </label>
        <label class="ctl ctl-check" title="Feed the real wall-clock into the scene so time-based goals (catch the last train, leave before midnight) actually bite. Turn off for timeless or period scenes.">Real time
          <input id="use-time" type="checkbox" checked />
        </label>
        <label class="ctl ctl-check" title="An AI showrunner. Each round it reads your story direction and the scene, then adds a short note steering the next beats: escalate, pay off a thread, force a turn, land the ending. Turn off for pure free-form improv.">Orchestrator
          <input id="orchestrate" type="checkbox" checked />
        </label>
        <button id="run-btn" type="button" class="primary-btn">Run scene</button>
        <button id="stop-btn" type="button" class="secondary-btn gate-hidden">Stop</button>
      </div>
      <div class="nudge-row">
        <input id="nudge" type="text" placeholder="Optional: nudge the scene before the next run (a knock at the door, a confession, a power cut...)" />
        <button id="nudge-btn" type="button" class="secondary-btn">Inject</button>
      </div>
      <p id="run-error" class="run-error gate-hidden"></p>
    </section>

    <!-- Transcript -->
    <section class="block">
      <div class="block-head">
        <h2>The scene</h2>
        <div class="scene-actions">
          <button id="copy-btn" type="button" class="subtle-btn">Copy</button>
          <button id="clear-btn" type="button" class="subtle-btn">Clear</button>
        </div>
      </div>
      <div id="transcript" class="transcript"></div>
      <p id="transcript-empty" class="hint">No scene yet. Add characters, set the situation, then run.</p>
    </section>
  </section>
</BaseLayout>

<style>
  #gate { display: flex; align-items: center; justify-content: center; min-height: 50vh; }
  .gate-box { text-align: center; max-width: 320px; width: 100%; }
  .gate-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: var(--code-bg); color: var(--fg-muted);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;
  }
  .gate-box h2 { margin-top: 0; margin-bottom: 0.2rem; font-size: 1.25rem; }
  .gate-sub { color: var(--fg-muted); font-size: 0.8rem; margin-bottom: 1.25rem; }
  #gate-form { display: flex; gap: 0.4rem; }
  #gate-password {
    flex: 1; padding: 0.55rem 0.85rem; border: 1px solid var(--border);
    border-radius: 10px; background: var(--bg); color: var(--fg);
    font-family: var(--font-mono); font-size: 0.84rem; outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  #gate-password:focus {
    border-color: var(--fg-muted);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fg-muted) 10%, transparent);
  }
  #gate-form button {
    padding: 0.55rem 1.25rem; background: var(--fg); color: var(--bg);
    border: none; border-radius: 10px; font-family: var(--font-body);
    font-size: 0.84rem; font-weight: 600; cursor: pointer; transition: opacity 0.15s;
  }
  #gate-form button:hover { opacity: 0.85; }
  .gate-error { color: #e54; font-size: 0.78rem; margin-top: 0.75rem; }
  .gate-hidden { display: none !important; }

  .story-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem;
  }
  .story-header h1 { margin: 0; font-size: 1.5rem; }
  .story-tagline { margin: 0.2rem 0 0; color: var(--fg-muted); font-size: 0.82rem; }

  .primary-btn {
    padding: 0.5rem 1.15rem; background: var(--fg); color: var(--bg);
    border: none; border-radius: 9px; font-family: var(--font-body);
    font-size: 0.84rem; font-weight: 600; cursor: pointer; transition: opacity 0.15s;
  }
  .primary-btn:hover { opacity: 0.85; }
  .primary-btn:disabled { opacity: 0.4; cursor: default; }
  .secondary-btn {
    padding: 0.4rem 0.9rem; background: transparent; color: var(--fg);
    border: 1px solid var(--border); border-radius: 8px; font-family: var(--font-body);
    font-size: 0.82rem; cursor: pointer;
  }
  .secondary-btn:hover { background: var(--code-bg); }
  .subtle-btn {
    padding: 0.25rem 0.6rem; background: transparent; color: var(--fg-muted);
    border: 1px solid var(--border); border-radius: 7px; font-family: var(--font-body);
    font-size: 0.74rem; cursor: pointer;
  }
  .subtle-btn:hover { color: var(--fg); }

  .block {
    border: 1px solid var(--border); border-radius: 12px;
    padding: 1.1rem 1.25rem; background: var(--code-bg); margin-bottom: 1.25rem;
  }
  .block-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.9rem; }
  .block-head h2 { margin: 0; font-size: 1.05rem; }
  .hint { font-size: 0.72rem; color: var(--fg-muted); margin: 0.7rem 0 0; line-height: 1.5; }

  .setup-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 760px) { .setup-grid { grid-template-columns: 1fr; } }

  .char-list { display: flex; flex-direction: column; gap: 0.75rem; }
  /* char rows are built at runtime via JS, so Astro's scoping skips them -- use :global */
  :global(.char-card) { border: 1px solid var(--border); border-radius: 10px; padding: 0.75rem; background: var(--bg); }
  :global(.char-card-top) { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
  :global(.char-dot) { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  :global(.char-name) {
    flex: 1; padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--fg); font-family: var(--font-body);
    font-size: 0.85rem; font-weight: 600; outline: none;
  }
  :global(.char-del) {
    padding: 0.3rem 0.5rem; background: transparent; color: var(--fg-muted);
    border: 1px solid var(--border); border-radius: 7px; font-size: 0.72rem; cursor: pointer;
  }
  :global(.char-del:hover) { color: #e54; border-color: #e54; }
  :global(.char-desc), .setting-input {
    width: 100%; padding: 0.5rem 0.65rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--fg); font-family: var(--font-body);
    font-size: 0.82rem; line-height: 1.5; outline: none; resize: vertical;
  }
  :global(.char-desc:focus), .setting-input:focus, :global(.char-name:focus) { border-color: var(--fg-muted); }
  :global(.char-goal) {
    width: 100%; margin-top: 0.5rem; padding: 0.45rem 0.6rem;
    border: 1px solid var(--border); border-left: 3px solid var(--c, var(--fg-muted));
    border-radius: 8px; background: var(--bg); color: var(--fg);
    font-family: var(--font-mono); font-size: 0.76rem; outline: none;
  }
  :global(.char-goal::placeholder) { font-family: var(--font-body); }
  :global(.char-goal:focus) { border-color: var(--fg-muted); }

  .run-block { background: var(--bg); }
  .run-controls { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.85rem; }
  .ctl { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--fg-muted); }
  .ctl select, .ctl input {
    padding: 0.4rem 0.55rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--code-bg); color: var(--fg); font-family: var(--font-body); font-size: 0.82rem;
  }
  .ctl input[type="number"] { width: 4.5rem; }
  .ctl-check { flex-direction: row; align-items: center; gap: 0.4rem; padding-bottom: 0.45rem; }
  .ctl-check input[type="checkbox"] { width: auto; cursor: pointer; accent-color: var(--fg); }
  .nudge-row { display: flex; gap: 0.5rem; margin-top: 0.9rem; }
  .nudge-row input {
    flex: 1; padding: 0.45rem 0.7rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--code-bg); color: var(--fg); font-family: var(--font-body); font-size: 0.8rem; outline: none;
  }
  .nudge-row input:focus { border-color: var(--fg-muted); }
  .run-error { color: #e54; font-size: 0.78rem; margin: 0.75rem 0 0; }

  .scene-actions { display: flex; gap: 0.4rem; }
  .transcript { display: flex; flex-direction: column; gap: 0.85rem; }
  :global(.beat) { padding-left: 0.75rem; border-left: 3px solid var(--c, var(--border)); }
  :global(.beat-name) { font-size: 0.78rem; font-weight: 700; color: var(--c, var(--fg)); margin-bottom: 0.15rem; }
  :global(.beat-text) { font-size: 0.9rem; line-height: 1.6; white-space: pre-wrap; }
  :global(.beat.director) { border-left-style: dashed; }
  :global(.beat.director .beat-name) { color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.68rem; }
  :global(.beat.director .beat-text) { color: var(--fg-muted); font-style: italic; }
  :global(.beat.orchestrator) { border-left-style: dotted; border-left-color: var(--c, var(--fg-muted)); }
  :global(.beat.orchestrator .beat-name) { color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.66rem; }
  :global(.beat.orchestrator .beat-text) { color: var(--fg-muted); font-style: italic; }
  :global(.beat.thinking .beat-text) { color: var(--fg-muted); font-style: italic; }

  /* Screenplay: name in caps over tight dialogue */
  :global(.beat.screenplay .beat-name) { text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.72rem; }

  /* Comic: name as a caption, dialogue in a bubble */
  :global(.beat.comic) { border-left: none; padding-left: 0; }
  :global(.beat.comic .beat-name) { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.7rem; margin-bottom: 0.3rem; }
  :global(.beat.comic .beat-text) {
    display: inline-block; background: var(--bg);
    border: 2px solid var(--c, var(--fg)); border-radius: 14px;
    padding: 0.5rem 0.85rem; font-size: 0.92rem; max-width: 90%;
  }
</style>

<script>
  import '../../lib/story-studio.js';
</script>
