@prefix f1:   <https://dustinlanders.com/ontology/f1#> .
@prefix f1m:  <https://dustinlanders.com/ontology/f1/schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# Direct mapping of the f1.db relational schema to OWL, generated from
# f1.schema.json. Each table is an owl:Class (f1m:), each column a
# property, each foreign key an owl:ObjectProperty. Table classes are
# tied to the conceptual model in f1.ttl via rdfs:subClassOf where a
# concept exists. Regenerate with: python3 build_f1db.py && (this script).

f1m: a owl:Ontology ;
    dct:title "Formula 1 Database Direct Mapping (f1.db schema)" ;
    owl:imports f1: ;
    owl:versionInfo "1.0.0" .

f1m:Continent a owl:Class ;
    rdfs:label "continent" ;
    rdfs:subClassOf f1:Continent ;
    f1:mapsToTable "continent" ;
    rdfs:comment "PK (id); 7 rows." .

f1m:Country a owl:Class ;
    rdfs:label "country" ;
    rdfs:subClassOf f1:Country ;
    f1:mapsToTable "country" ;
    rdfs:comment "PK (id); 249 rows." .

f1m:Circuit a owl:Class ;
    rdfs:label "circuit" ;
    rdfs:subClassOf f1:Circuit ;
    f1:mapsToTable "circuit" ;
    rdfs:comment "PK (id); 78 rows." .

f1m:CircuitLayout a owl:Class ;
