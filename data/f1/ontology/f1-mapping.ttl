#### Object properties (foreign keys) ####

f1m:country__continent_id a owl:ObjectProperty ;
    rdfs:label "country.continent_id" ;
    rdfs:domain f1m:Country ;
    rdfs:range f1m:Continent ;
    f1:mapsToColumn "country.continent_id" .

f1m:circuit__country_id a owl:ObjectProperty ;
    rdfs:label "circuit.country_id" ;
