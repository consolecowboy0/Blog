---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A blog.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var valid = (saved === 'vanaheim' || saved === 'muspelheim' || saved === 'niflheim' || saved === 'alfheim' || saved === 'midgard' || saved === 'jotunheim' || saved === 'svartalfheim' || saved === 'helheim') ? saved : 'rainbow';
        document.documentElement.setAttribute('data-theme', valid);
      })();
    </script>
    <script is:inline>
      // First-party pageview beacon. Fire-and-forget, no cookies.
      (function() {
        try {
          var p = location.pathname;
          if (/^\/(analytics)(\/|$)/.test(p)) return;

          // UTM: only on the first pageview of a session, so refreshes and deep
          // navigation don't re-credit a campaign for the whole visit.
          var utm = null;
          try {
            if (!sessionStorage.getItem('utm_seen')) {
              var q = new URLSearchParams(location.search);
              var keys = ['utm_source', 'utm_medium', 'utm_campaign'];
              var o = {};
              for (var i = 0; i < keys.length; i++) {
                var v = q.get(keys[i]);
                if (v) o[keys[i].slice(4)] = String(v).slice(0, 120);
              }
              if (Object.keys(o).length) utm = o;
              sessionStorage.setItem('utm_seen', '1');
            }
          } catch (e) {}

          // Owner self-flag: set via the /analytics "This is me" button, which
          // writes localStorage.analytics_owner='1'. Lets the dashboard exclude
          // the owner's own visits from the where-from breakdowns.
          var own = false;
          try { own = localStorage.getItem('analytics_owner') === '1'; } catch (e) {}

          var body = { path: p, ref: document.referrer || '' };
          if (utm) body.utm = utm;
          if (own) body.own = 1;

          fetch('/api/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify(body),
          }).catch(function() {});
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <header>
      <nav>
        <div class="nav-brand">
          <!-- Stag sigil: Asgard-only antler ornament -->
          <svg class="asgard-sigil" viewBox="0 0 32 22" width="26" height="18" fill="none" aria-hidden="true">
            <path d="M16 21 C14 16 11 12 9 8 C8 5.5 8.5 3 10.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M9.8 9.5 L7 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M10.8 13.5 L8 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M16 21 C18 16 21 12 23 8 C24 5.5 23.5 3 21.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M22.2 9.5 L25 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M21.2 13.5 L24 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <a href="/" class="site-title">dustinlanders.com</a>
          <!-- Subtle current-theme readout. Names toggle via data-theme; the toggle
               button itself stays icon-only. -->
          <span class="theme-indicator">theme
            <span class="theme-name theme-name-rainbow">asgard</span>
            <span class="theme-name theme-name-vanaheim">vanaheim</span>
            <span class="theme-name theme-name-muspelheim">muspelheim</span>
            <span class="theme-name theme-name-niflheim">niflheim</span>
            <span class="theme-name theme-name-alfheim">alfheim</span>
            <span class="theme-name theme-name-midgard">midgard</span>
            <span class="theme-name theme-name-jotunheim">jotunheim</span>
            <span class="theme-name theme-name-svartalfheim">svartalfheim</span>
            <span class="theme-name theme-name-helheim">helheim</span>
          </span>
        </div>
        <div class="nav-links">
          <button id="theme-toggle" aria-label="Switch theme">
            <!-- Generic theme-switch symbol (contrast circle). The brand sigils
                 live by the wordmark; this button stays theme-neutral. -->
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
              <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-row">
        <p>&copy; {new Date().getFullYear()} <a href="/dev" class="dev-dot">·</a> <a href="https://vectorracer.com">vectorracer</a> <a href="/whitelightning">white lightning</a></p>
        <div class="social-icons">
        <a href="https://instagram.com/LandersDustin" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="5"></circle>
            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a href="https://facebook.com/dustin.landers" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
        <a href="/analytics" aria-label="Analytics" class="social-link secret-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.5rem;
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    border: none;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  @media (max-width: 480px) {
    nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
    }
  }

  .nav-links a {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    border: none;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    min-height: 60vh;
  }

  footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-row p {
    margin: 0;
  }

  .social-icons {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    color: var(--fg-muted);
    border: none;
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    color: var(--fg);
  }

  .secret-link {
    opacity: 0.08;
  }
  .secret-link:hover {
    opacity: 0.6;
  }

  .dev-dot {
    color: inherit;
    border: none;
    text-decoration: none;
    cursor: default;
  }

  .dev-dot:hover {
    color: inherit;
    opacity: 1;
  }

  /* Carries each theme's signature color (asgard gold, vanaheim green)
     via --accent, so the switch tints with the theme. */
  #theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--accent);
    opacity: 0.7;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    transition: color 0.2s, opacity 0.2s;
  }

  #theme-toggle:hover {
    opacity: 1;
  }

  /* Brand cluster: wordmark + a subtle "theme <name>" readout to its right. */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* Quiet, lowercase current-theme readout beside the wordmark. */
  .theme-indicator {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    opacity: 0.7;
  }

  .theme-name { display: none; }
  :global([data-theme="rainbow"]) .theme-name-rainbow { display: inline; }
  :global([data-theme="vanaheim"]) .theme-name-vanaheim { display: inline; }
  :global([data-theme="muspelheim"]) .theme-name-muspelheim { display: inline; }
  :global([data-theme="niflheim"]) .theme-name-niflheim { display: inline; }
  :global([data-theme="alfheim"]) .theme-name-alfheim { display: inline; }
  :global([data-theme="midgard"]) .theme-name-midgard { display: inline; }
  :global([data-theme="jotunheim"]) .theme-name-jotunheim { display: inline; }
  :global([data-theme="svartalfheim"]) .theme-name-svartalfheim { display: inline; }
  :global([data-theme="helheim"]) .theme-name-helheim { display: inline; }

  /* A quick half-turn spin each time you switch themes (set inline in JS). */
  #theme-toggle svg {
    transition: transform 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle svg { transition: none; transform: none !important; }
  }

</style>

<script>
  function broadcastThemeToEmbeds(theme: string) {
    document.querySelectorAll('iframe').forEach((iframe) => {
      try {
        iframe.contentWindow?.postMessage({ type: 'parent-theme', theme }, window.location.origin);
      } catch { /* cross-origin — ignore */ }
    });
  }

  let themeSpin = 0;
  document.getElementById('theme-toggle')?.addEventListener('click', (e) => {
    const order = ['rainbow', 'vanaheim', 'muspelheim', 'niflheim', 'alfheim', 'midgard', 'jotunheim', 'svartalfheim', 'helheim'];
    const current = document.documentElement.getAttribute('data-theme') || 'rainbow';
    const idx = order.indexOf(current);
    const next = order[(idx + 1) % order.length];
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    broadcastThemeToEmbeds(next);
    // Accumulate a half-turn per press so the icon spins fresh and never sticks tilted.
    themeSpin += 180;
    const svg = (e.currentTarget as HTMLElement).querySelector('svg');
    if (svg) svg.style.transform = 'rotate(' + themeSpin + 'deg)';
  });
</script>
