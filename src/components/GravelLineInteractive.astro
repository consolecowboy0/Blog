<section class="line-lab" aria-labelledby="line-lab-title">
  <header class="line-lab__intro">
    <p class="line-lab__eyebrow">Interactive driving lesson</p>
    <h2 id="line-lab-title">Same corner. Different job.</h2>
    <p>
      Scrub through one identical ninety-degree corner. On tarmac, the car's heading and direction of travel stay
      nearly aligned. On gravel, the driver rotates the car earlier so it points toward the exit before its momentum
      has fully changed direction.
    </p>
  </header>

  <div class="line-lab__toolbar">
    <button id="line-play" type="button">Play</button>
    <label for="line-progress">Corner progress</label>
    <input id="line-progress" type="range" min="0" max="100" value="0" step="0.1" />
    <output id="line-phase">Braking</output>
  </div>

  <div class="line-lab__key" aria-label="Vector legend">
    <span><i class="heading-key"></i>Car heading</span>
    <span><i class="velocity-key"></i>Direction of travel</span>
  </div>

  <svg class="line-lab__diagram" viewBox="0 0 1000 470" role="img" aria-labelledby="line-title line-desc">
    <title id="line-title">Tarmac and gravel cars negotiating the same corner</title>
    <desc id="line-desc">
      Two synchronized cars follow smoothly curved paths through identical corners. The tarmac car remains nearly
      aligned with its direction of travel. The gravel car rotates earlier, creating a larger angle between heading
      and direction of travel during the middle of the corner.
    </desc>
    <defs>
      <pattern id="gravel-pattern" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="3" cy="4" r="1" />
        <circle cx="10" cy="9" r="1.2" />
      </pattern>
      <marker id="heading-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
        <path d="M0 0 L7 3.5 L0 7 Z" />
      </marker>
      <marker id="velocity-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
        <path d="M0 0 L7 3.5 L0 7 Z" />
      </marker>
    </defs>

    <g>
      <text class="panel-title" x="250" y="34" text-anchor="middle">TARMAC</text>
      <text class="panel-subtitle" x="250" y="56" text-anchor="middle">Maximize radius. Keep the tire working cleanly.</text>
      <rect class="panel-bg tarmac-bg" x="18" y="72" width="464" height="370" rx="18" />
      <path class="road tarmac-road" d="M55 380 H205 C330 380 415 295 415 170 V105" />
      <path id="tarmac-path" class="guide-line" d="M55 395 C165 395 245 395 300 360 C365 318 402 265 408 215 C411 188 413 150 415 105" />
      <line id="tarmac-velocity" class="velocity-vector" />
      <line id="tarmac-heading" class="heading-vector" />
      <g id="tarmac-car" class="car tarmac-car">
        <rect x="-20" y="-10" width="40" height="20" rx="6" />
        <path d="M-9 -10 V10 M9 -10 V10" />
      </g>
      <rect class="coach-note-bg" x="34" y="91" width="300" height="31" rx="8" />
      <text id="tarmac-note" class="coach-note" x="46" y="112">Brake in a straight line.</text>
    </g>

    <g transform="translate(500 0)">
      <text class="panel-title" x="250" y="34" text-anchor="middle">GRAVEL</text>
      <text class="panel-subtitle" x="250" y="56" text-anchor="middle">Use weight transfer to rotate, then drive out.</text>
      <rect class="panel-bg gravel-bg" x="18" y="72" width="464" height="370" rx="18" />
      <path class="road gravel-road" d="M55 380 H205 C330 380 415 295 415 170 V105" />
      <path id="gravel-path" class="guide-line" d="M55 395 C155 395 232 392 287 358 C345 322 386 270 399 220 C407 188 412 150 415 105" />
      <line id="gravel-velocity" class="velocity-vector" />
      <line id="gravel-heading" class="heading-vector" />
      <g id="gravel-car" class="car gravel-car">
        <rect x="-20" y="-10" width="40" height="20" rx="6" />
        <path d="M-9 -10 V10 M9 -10 V10" />
      </g>
      <text id="gravel-note" class="coach-note" x="40" y="420">Brake and load the front tires.</text>
    </g>
  </svg>

  <div class="line-lab__readout" aria-live="polite">
    <div><span>Tarmac</span><strong id="tarmac-readout">Heading follows velocity</strong></div>
    <div><span>Gravel</span><strong id="gravel-readout">Building rotation</strong></div>
  </div>

  <p class="line-lab__takeaway">
    The gravel car is not taking a magical shortcut. The important difference is timing: it changes its heading
    earlier, accepts controlled slip, and reaches the exit already pointed where it wants to accelerate.
  </p>
</section>

<style>
  .line-lab { --ink:#171717; --muted:#686868; --orange:#c86718; margin:4rem 0; color:var(--ink); }
  .line-lab__intro { max-width:48rem; margin-bottom:1.25rem; }
  .line-lab__intro h2 { margin:.2rem 0 .7rem; font-size:clamp(1.8rem,4vw,3rem); line-height:1.05; }
  .line-lab__intro p { margin:0; color:var(--muted); }
  .line-lab__eyebrow { color:var(--orange)!important; font:700 .72rem/1.2 ui-monospace,monospace; letter-spacing:.14em; text-transform:uppercase; }
  .line-lab__toolbar { display:grid; grid-template-columns:auto auto 1fr auto; gap:.8rem; align-items:center; padding:1rem; border:1px solid #ddd6cc; border-radius:16px; background:#fff; }
  .line-lab__toolbar button { border:0; border-radius:999px; padding:.7rem 1.1rem; background:var(--ink); color:#fff; font:inherit; font-weight:700; cursor:pointer; }
  .line-lab__toolbar label { font-size:.82rem; font-weight:700; }
  .line-lab__toolbar input { width:100%; accent-color:var(--orange); }
  .line-lab__toolbar output { min-width:6rem; font:700 .8rem/1.2 ui-monospace,monospace; text-align:right; text-transform:uppercase; }
  .line-lab__key { display:flex; flex-wrap:wrap; gap:1rem; margin:.9rem 0; color:var(--muted); font-size:.85rem; }
  .line-lab__key span { display:inline-flex; align-items:center; gap:.45rem; }
  .line-lab__key i { width:1.6rem; height:.2rem; display:inline-block; }
  .heading-key { background:var(--orange); }
  .velocity-key { border-top:3px dashed #222; }
  .line-lab__diagram { display:block; width:100%; height:auto; background:#fff; }
  .panel-bg { stroke:#d8d1c6; stroke-width:1.5; }
  .tarmac-bg { fill:#f4f4f2; }
  .gravel-bg { fill:#f4efe7; }
  .road { fill:none; stroke-width:96; stroke-linecap:round; stroke-linejoin:round; }
  .tarmac-road { stroke:#666; }
  .gravel-road { stroke:url(#gravel-pattern); }
  #gravel-pattern circle { fill:#8b7d6a; }
  .guide-line { fill:none; stroke:#fff; stroke-width:2; stroke-dasharray:8 10; opacity:.72; }
  .panel-title { fill:var(--ink); font:700 15px/1 ui-monospace,monospace; letter-spacing:.14em; }
  .panel-subtitle,.coach-note { fill:var(--muted); font:13px/1.2 Inter,system-ui,sans-serif; }
  .coach-note-bg { fill:#fff; stroke:#d8d1c6; stroke-width:1; opacity:.96; }
  .coach-note { font-weight:650; }
  .car rect { stroke:#fff; stroke-width:2; }
  .car path { fill:none; stroke:#fff; stroke-width:2; opacity:.75; }
  .tarmac-car rect { fill:#2563a8; }
  .gravel-car rect { fill:var(--orange); }
  .heading-vector { stroke:var(--orange); stroke-width:4; marker-end:url(#heading-arrow); }
  .velocity-vector { stroke:#222; stroke-width:3; stroke-dasharray:6 5; marker-end:url(#velocity-arrow); }
  #heading-arrow path { fill:var(--orange); }
  #velocity-arrow path { fill:#222; }
  .line-lab__readout { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; margin-top:.8rem; }
  .line-lab__readout div { padding:1rem; border:1px solid #ddd6cc; border-radius:14px; background:#fff; }
  .line-lab__readout span { display:block; color:var(--muted); font-size:.76rem; text-transform:uppercase; letter-spacing:.1em; }
  .line-lab__readout strong { display:block; margin-top:.2rem; }
  .line-lab__takeaway { margin:1rem 0 0; padding:1rem 1.1rem; border-left:4px solid var(--orange); background:#fff7ed; font-weight:650; }
  @media(max-width:680px){
    .line-lab__toolbar { grid-template-columns:auto 1fr; }
    .line-lab__toolbar label { display:none; }
    .line-lab__toolbar output { grid-column:1/-1; text-align:left; }
    .line-lab__readout { grid-template-columns:1fr; }
  }
</style>

<script>
  const root = document.querySelector('.line-lab');
  if (root) {
    const progress = root.querySelector('#line-progress');
    const play = root.querySelector('#line-play');
    const phase = root.querySelector('#line-phase');
    const tarmacPath = root.querySelector('#tarmac-path');
    const gravelPath = root.querySelector('#gravel-path');
    const tarmacCar = root.querySelector('#tarmac-car');
    const gravelCar = root.querySelector('#gravel-car');
    const tarmacVelocity = root.querySelector('#tarmac-velocity');
    const gravelVelocity = root.querySelector('#gravel-velocity');
    const tarmacHeading = root.querySelector('#tarmac-heading');
    const gravelHeading = root.querySelector('#gravel-heading');
    let animation = 0;
    let playing = false;
    let lastTime = 0;

    const phases = [
      { max:25, name:'Braking', road:'Brake straight; keep the platform settled.', gravel:'Brake and load the front tires.' },
      { max:55, name:'Rotation', road:'Turn once and build lateral load smoothly.', gravel:'Release the brake and rotate the car early.' },
      { max:78, name:'Apex', road:'Heading and velocity remain almost aligned.', gravel:'The nose points toward the exit before momentum does.' },
      { max:101, name:'Exit', road:'Unwind steering and add throttle.', gravel:'Velocity catches the heading; drive out.' },
    ];

    function angleAt(path, distance) {
      const length = path.getTotalLength();
      const a = path.getPointAtLength(Math.max(0, distance - 2));
      const b = path.getPointAtLength(Math.min(length, distance + 2));
      return Math.atan2(b.y - a.y, b.x - a.x) * 180 / Math.PI;
    }

    function setVector(line, point, angle, length) {
      const radians = angle * Math.PI / 180;
      line.setAttribute('x1', String(point.x));
      line.setAttribute('y1', String(point.y));
      line.setAttribute('x2', String(point.x + Math.cos(radians) * length));
      line.setAttribute('y2', String(point.y + Math.sin(radians) * length));
    }

    function gravelYaw(p) {
      if (p < .22 || p > .88) return 0;
      const normalized = (p - .22) / .66;
      return Math.sin(normalized * Math.PI) * 28;
    }

    function render() {
      const value = progress.valueAsNumber;
      const p = value / 100;
      const roadLength = tarmacPath.getTotalLength();
      const gravelLength = gravelPath.getTotalLength();
      const roadPoint = tarmacPath.getPointAtLength(roadLength * p);
      const gravelPoint = gravelPath.getPointAtLength(gravelLength * p);
      const roadVelocityAngle = angleAt(tarmacPath, roadLength * p);
      const gravelVelocityAngle = angleAt(gravelPath, gravelLength * p);
      const roadHeadingAngle = roadVelocityAngle - Math.sin(p * Math.PI) * 2.5;
      const gravelHeadingAngle = gravelVelocityAngle - gravelYaw(p);

      tarmacCar.setAttribute('transform', `translate(${roadPoint.x} ${roadPoint.y}) rotate(${roadHeadingAngle})`);
      gravelCar.setAttribute('transform', `translate(${gravelPoint.x} ${gravelPoint.y}) rotate(${gravelHeadingAngle})`);
      setVector(tarmacVelocity, roadPoint, roadVelocityAngle, 55);
      setVector(gravelVelocity, gravelPoint, gravelVelocityAngle, 55);
      setVector(tarmacHeading, roadPoint, roadHeadingAngle, 62);
      setVector(gravelHeading, gravelPoint, gravelHeadingAngle, 62);

      const current = phases.find((item) => value < item.max) || phases[3];
      phase.textContent = current.name;
      root.querySelector('#tarmac-note').textContent = current.road;
      root.querySelector('#gravel-note').textContent = current.gravel;
      root.querySelector('#tarmac-readout').textContent = value < 78 ? 'Heading closely follows velocity' : 'Steering unwinds on exit';
      root.querySelector('#gravel-readout').textContent = value < 25 ? 'Building front load' : value < 78 ? 'Heading leads velocity' : 'Velocity catches the heading';
    }

    function tick(time) {
      if (!playing) return;
      if (!lastTime) lastTime = time;
      const elapsed = time - lastTime;
      lastTime = time;
      const next = progress.valueAsNumber + elapsed * 0.008;
      progress.valueAsNumber = next > 100 ? 0 : next;
      render();
      animation = requestAnimationFrame(tick);
    }

    progress.addEventListener('input', () => {
      playing = false;
      lastTime = 0;
      play.textContent = 'Play';
      cancelAnimationFrame(animation);
      render();
    });
    play.addEventListener('click', () => {
      playing = !playing;
      lastTime = 0;
      play.textContent = playing ? 'Pause' : 'Play';
      cancelAnimationFrame(animation);
      if (playing) animation = requestAnimationFrame(tick);
    });
    render();
  }
</script>
