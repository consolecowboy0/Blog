---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Writing · dustinlanders.com" description="All posts.">
  <section class="post-list">
    <h1>Writing</h1>
    <div class="post-grid">
    {posts.map((post) => {
      const dateStr = new Date(post.data.date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      return (
        <a href={`/posts/${post.id}`} class="post-item">
          <time datetime={post.data.date}>{dateStr}</time>
          <h2>{post.data.title}</h2>
          {post.data.description && <p>{post.data.description}</p>}
        </a>
      );
    })}
    </div>
  </section>
</BaseLayout>

<style>
  .post-list h1 {
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2.5rem;
  }

  .post-item {
    display: block;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    border-left: none;
    border-right: none;
    border-top: none;
  }

  /* Top border on the first item of each column */
  .post-item:nth-child(1),
  .post-item:nth-child(2) {
    border-top: 1px solid var(--border);
  }

  .post-item:hover h2 {
    opacity: 0.6;
  }

  @media (max-width: 700px) {
    .post-grid {
      grid-template-columns: 1fr;
    }

    .post-item:nth-child(2) {
      border-top: none;
    }
  }

  .post-item time {
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-item h2 {
    font-size: 1.25rem;
    margin: 0.25rem 0 0.35rem;
    transition: opacity 0.2s;
  }

  .post-item p {
    font-size: 0.9rem;
    color: var(--fg-muted);
    margin: 0;
  }
</style>
