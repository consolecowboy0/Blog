---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Learning to race a daily-driven VB WRX — an interactive field note." />
    <title>Learning the Line — dustinlanders.com</title>
    <link rel="icon" type="image/png" href="/falcon-favicon.png?v=5" />
    <script is:inline src="/beacon.js"></script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"><span id="progressBar"></span></div>

    <nav class="site-nav" aria-label="Site navigation">
      <a href="/" class="back" aria-label="Back home">&larr;</a>
      <span>motorsport / field note 001</span>
      <span class="readout" id="sectionReadout">the car</span>
    </nav>

    <main>
      <section class="hero story-section" data-section="the car">
        <div class="eyebrow">A DAILY DRIVER GOES RACING</div>
        <h1>Learning<br />the <em>line.</em></h1>
        <p class="dek">
          One mostly stock VB WRX. Four different tires. A parking lot full of
          cones. This is the beginning of learning what the car—and its driver—can do.
        </p>
        <div class="hero-car" aria-label="Illustration of a silver Subaru WRX">
          <svg viewBox="0 0 1000 360" role="img" aria-labelledby="carTitle">
            <title id="carTitle">Silver VB-generation Subaru WRX in profile</title>
            <defs>
              <linearGradient id="paint" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f7f8f9"/>
                <stop offset=".48" stop-color="#c9ced2"/>
                <stop offset="1" stop-color="#858c91"/>
              </linearGradient>
              <linearGradient id="glass" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#52616a"/>
                <stop offset="1" stop-color="#151b1f"/>
              </linearGradient>
            </defs>
            <ellipse class="shadow" cx="500" cy="307" rx="390" ry="23"/>
            <path class="car-body" d="M112 246 C128 205 181 185 267 171 L350 96 C373 74 402 64 449 63 L604 63 C644 66 676 85 705 116 L759 173 C836 183 883 203 905 236 L915 273 L856 285 C850 235 814 208 770 208 C724 208 688 239 684 288 L334 288 C330 239 293 208 248 208 C203 208 167 237 162 282 L100 273 Z"/>
            <path class="glass" d="M363 104 C385 84 410 79 452 78 L507 78 L507 159 L296 159 Z"/>
            <path class="glass" d="M525 78 L600 78 C633 82 656 96 681 124 L713 160 L525 160 Z"/>
            <path class="trim" d="M282 174 L737 174"/>
            <path class="door" d="M519 169 L519 272 M707 169 L690 270 M363 171 L348 267"/>
            <path class="scoop" d="M210 185 L315 173 L344 182 L240 193 Z"/>
            <path class="wing" d="M754 153 L868 150 L870 164 L773 170 Z"/>
            <path class="bumper" d="M107 245 L168 241 M851 244 L909 241"/>
            <g class="wheel wheel-rear" transform="translate(770 277)">
              <circle class="tire" r="70"/><circle class="rim" r="47"/><circle class="hub" r="10"/>
              <path class="spokes" d="M0-43V-12 M30-30L9-9 M43 0H12 M30 30L9 9 M0 43V12 M-30 30L-9 9 M-43 0H-12 M-30-30L-9-9"/>
            </g>
            <g class="wheel wheel-front" transform="translate(248 277)">
              <circle class="tire" r="70"/><circle class="rim" r="47"/><circle class="hub" r="10"/>
              <path class="spokes" d="M0-43V-12 M30-30L9-9 M43 0H12 M30 30L9 9 M0 43V12 M-30 30L-9 9 M-43 0H-12 M-30-30L-9-9"/>
            </g>
            <path class="ground" d="M55 348 H945"/>
          </svg>
        </div>
        <div class="hero-meta">
          <span>2022+ SUBARU WRX</span>
          <span>VB CHASSIS</span>
          <span>AWD / 6MT</span>
        </div>
        <div class="scroll-cue" aria-hidden="true"><span></span>scroll to wrench</div>
      </section>

      <section class="chapter story-section" data-section="the setup">
        <div class="chapter-copy">
          <div class="chapter-no">01 / THE SETUP</div>
          <h2>Change less.<br /><em>Learn more.</em></h2>
          <p>
            The temptation is to start with power. But a stock-class car is an
            experiment with fewer variables: learn the chassis, learn the surface,
            and discover how much speed was hiding in the driver.
          </p>
          <p>
            For the first event, the meaningful change happens where every input
            finally reaches the ground: the tires.
          </p>
        </div>

        <div class="sticky-stage tire-stage">
          <div class="stage-label">TAP TO COMPARE</div>
          <button class="wheel-demo" id="wheelDemo" type="button" aria-pressed="false" aria-label="Swap between road and all-weather tire">
            <svg viewBox="0 0 500 500" role="img" aria-label="Interactive wheel and tire">
              <circle class="tire-outer" cx="250" cy="250" r="205"/>
              <circle class="tire-inner" cx="250" cy="250" r="131"/>
              <g class="tread road-tread">
                <path d="M193 48l16 59M254 43l-2 62M316 53l-20 58M370 80l-36 51M414 122l-50 39M443 178l-58 20M455 240l-61 1M446 302l-59-17M419 359l-52-34M377 405l-39-48M323 437l-24-57M262 456l-5-61M200 450l14-59M142 426l32-53M94 389l47-41M61 337l56-25M45 278l61-7M46 215l60 12M66 156l54 30M101 105l43 44M150 68l28 55"/>
              </g>
              <g class="tread weather-tread">
                <path d="M193 48l24 55-20 29M254 43l3 61-24 22M316 53l-15 58-31 14M370 80l-35 51-35 5M414 122l-49 39-35-5M443 178l-58 20-32-16M455 240l-61 1-26-27M446 302l-59-17-17-34M419 359l-52-34-5-37M377 405l-39-48 8-36M323 437l-24-57 19-31M262 456l-5-61 29-24M200 450l14-59 35-15M142 426l32-53 37-3M94 389l47-41 36 10M61 337l56-25 31 22M45 278l61-7 24 30M46 215l60 12 13 34M66 156l54 30 1 37M101 105l43 44-10 36M150 68l28 55-21 31"/>
              </g>
              <circle class="rim-large" cx="250" cy="250" r="126"/>
              <circle class="rim-center" cx="250" cy="250" r="31"/>
              <g class="rim-spokes">
                <path d="M250 219V134 M272 228l60-60 M281 250h85 M272 272l60 60 M250 281v85 M228 272l-60 60 M219 250h-85 M228 228l-60-60"/>
              </g>
            </svg>
          </button>
          <div class="spec-card">
            <div>
              <span class="spec-kicker" id="tireKicker">BASELINE</span>
              <strong id="tireName">Road tire</strong>
            </div>
            <p id="tireCopy">Known, predictable, and already on the car. The reference point.</p>
          </div>
        </div>
      </section>

      <section class="classroom story-section" data-section="the rules">
        <div class="chapter-no">02 / RUN WHAT YOU BRUNG</div>
        <h2>What does<br /><em>“stock”</em> mean?</h2>
        <p class="intro">
          Not untouched. Stock-class competition limits the parts that can rewrite
          the car’s behavior. The exact rulebook depends on the event, but the idea
          is constant: keep the hardware close and make the driver the variable.
        </p>
        <div class="rules-grid">
          <article class="rule-card yes">
            <span class="rule-mark">✓</span>
            <h3>Prepare</h3>
            <ul>
              <li>Appropriate tires</li>
              <li>Fresh fluids</li>
              <li>Safe brake pads</li>
              <li>Pressure adjustments</li>
            </ul>
          </article>
          <article class="rule-card no">
            <span class="rule-mark">—</span>
            <h3>Resist, for now</h3>
            <ul>
              <li>Chasing horsepower</li>
              <li>Rewriting the suspension</li>
              <li>Removing weight</li>
              <li>Changing five things at once</li>
            </ul>
          </article>
        </div>
        <p class="rule-note">Always read the organizer’s current rulebook before entering a class.</p>
      </section>

      <section class="course-intro story-section" data-section="the course">
        <div class="course-copy">
          <div class="chapter-no">03 / READ THE COURSE</div>
          <h2>A parking lot<br />becomes a <em>puzzle.</em></h2>
          <p>
            Autocross trades wheel-to-wheel racing for a temporary course and a
            clock. One car runs at a time. The cones tell you where to go—but not
            the fastest way to get there.
          </p>
        </div>
        <div class="cone-field" aria-hidden="true">
          <span style="--x:8%;--y:30%;--r:-8deg"></span><span style="--x:18%;--y:66%;--r:5deg"></span>
          <span style="--x:35%;--y:21%;--r:9deg"></span><span style="--x:46%;--y:72%;--r:-4deg"></span>
          <span style="--x:64%;--y:28%;--r:7deg"></span><span style="--x:78%;--y:64%;--r:-9deg"></span>
          <span style="--x:91%;--y:32%;--r:3deg"></span>
          <svg viewBox="0 0 900 250" preserveAspectRatio="none">
            <path d="M12 129 C120 50 178 207 292 126 S465 48 572 128 S745 210 890 112"/>
          </svg>
        </div>
      </section>

      <section class="lesson story-section" data-section="the apex">
        <div class="lesson-head">
          <div class="chapter-no">04 / FIND THE APEX</div>
          <h2>The shortest line<br />isn’t always the <em>fastest.</em></h2>
          <p>
            The apex is the innermost point of the path through a corner. Move it,
            and you change what happens before and after it. Try the three lines.
          </p>
        </div>

        <div class="apex-lab">
          <div class="track-map">
            <svg viewBox="0 0 720 620" role="img" aria-labelledby="apexTitle">
              <title id="apexTitle">Interactive diagram comparing racing lines through a corner</title>
              <path class="track-outer" d="M68 574 L68 385 C68 168 190 59 421 59 L663 59"/>
              <path class="track-inner" d="M264 574 L264 399 C264 297 322 255 428 255 L663 255"/>
              <path class="curb" d="M269 390 C281 304 330 266 426 258"/>
              <path class="race-line early active" data-line="early" d="M161 585 C160 319 222 185 414 149 C506 132 577 149 684 170"/>
              <path class="race-line geometric" data-line="geometric" d="M161 585 C161 365 242 174 427 157 C518 149 598 157 684 157"/>
              <path class="race-line late" data-line="late" d="M161 585 C156 421 180 256 374 174 C466 136 566 128 684 144"/>
              <circle class="car-dot" id="carDot" cx="161" cy="585" r="13"/>
              <g class="apex-pin" id="apexPin" transform="translate(307 280)">
                <circle r="18"/><path d="M0 18L-7 33H7Z"/><text x="28" y="6">APEX</text>
              </g>
              <text class="map-label" x="112" y="548">BRAKE</text>
              <text class="map-label" x="561" y="112">ACCELERATE</text>
            </svg>
          </div>
          <div class="line-controls" role="group" aria-label="Choose a racing line">
            <button class="line-button active" data-choice="early" type="button">
              <span>01</span><strong>Early</strong><small>Easy entry. Tight exit.</small>
            </button>
            <button class="line-button" data-choice="geometric" type="button">
              <span>02</span><strong>Geometric</strong><small>Balanced, constant arc.</small>
            </button>
            <button class="line-button" data-choice="late" type="button">
              <span>03</span><strong>Late</strong><small>Patient entry. Faster exit.</small>
            </button>
          </div>
          <div class="lesson-result">
            <span id="lineVerdict">EARLY APEX</span>
            <p id="lineExplanation">You reach the inside too soon. The road runs out just as you want to accelerate.</p>
          </div>
        </div>
      </section>

      <section class="transfer story-section" data-section="weight transfer">
        <div class="transfer-copy">
          <div class="chapter-no">05 / MOVE THE WEIGHT</div>
          <h2>The car is never<br />really <em>still.</em></h2>
          <p>
            Brake and load moves forward. Accelerate and it moves rearward. Turn
            and the outside tires do more work. Smooth inputs keep that movement
            useful instead of surprising.
          </p>
          <label for="inputSlider">DRIVER INPUT <output id="inputLabel">COAST</output></label>
          <input id="inputSlider" type="range" min="-100" max="100" value="0" />
          <div class="range-labels"><span>BRAKE</span><span>ACCELERATE</span></div>
        </div>
        <div class="transfer-viz" id="transferViz">
          <svg viewBox="0 0 720 350" role="img" aria-label="Car diagram showing longitudinal weight transfer">
            <path class="mini-body" d="M104 229 C130 177 199 163 281 150 L342 98 C363 79 385 72 425 72 H511 C548 75 577 92 605 123 L632 157 C678 170 699 192 704 226 L680 244 H105Z"/>
            <path class="mini-glass" d="M294 146L357 91C371 80 390 79 426 79V146ZM441 79h67c31 3 53 17 77 45l19 22H441Z"/>
            <g class="axle front" transform="translate(221 246)">
              <circle class="load-ring" r="67"/><circle class="mini-wheel" r="48"/>
              <text y="88" text-anchor="middle">FRONT LOAD</text>
            </g>
            <g class="axle rear" transform="translate(588 246)">
              <circle class="load-ring" r="67"/><circle class="mini-wheel" r="48"/>
              <text y="88" text-anchor="middle">REAR LOAD</text>
            </g>
            <path class="force-arrow" id="forceArrow" d="M405 42h0"/>
          </svg>
          <div class="balance"><span id="frontPct">50</span><i></i><span id="rearPct">50</span></div>
        </div>
      </section>

      <section class="finale story-section" data-section="the start">
        <div class="final-mark">001</div>
        <div>
          <div class="chapter-no">TO BE CONTINUED</div>
          <h2>The first modification<br />is the <em>driver.</em></h2>
          <p>
            Next: the first course walk, the first timed run, and the long list of
            things the cones will teach us.
          </p>
          <a class="home-link" href="/">back to dustinlanders.com <span>→</span></a>
        </div>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Dustin Landers</span>
      <span>Field note 001 / prototype</span>
    </footer>

    <script>
      const progressBar = document.getElementById('progressBar');
      const readout = document.getElementById('sectionReadout');
      const sections = [...document.querySelectorAll('.story-section')];

      function updateScroll() {
        const max = document.documentElement.scrollHeight - innerHeight;
        progressBar.style.transform = `scaleX(${max ? scrollY / max : 0})`;
        let current = sections[0];
        for (const section of sections) {
          if (section.getBoundingClientRect().top < innerHeight * .42) current = section;
        }
        readout.textContent = current.dataset.section || '';
      }
      addEventListener('scroll', updateScroll, { passive: true });
      updateScroll();

      const wheelDemo = document.getElementById('wheelDemo');
      const tireKicker = document.getElementById('tireKicker');
      const tireName = document.getElementById('tireName');
      const tireCopy = document.getElementById('tireCopy');
      wheelDemo.addEventListener('click', () => {
        const changed = wheelDemo.getAttribute('aria-pressed') !== 'true';
        wheelDemo.setAttribute('aria-pressed', String(changed));
        wheelDemo.classList.toggle('changed', changed);
        tireKicker.textContent = changed ? 'EVENT SETUP' : 'BASELINE';
        tireName.textContent = changed ? 'All-weather tire' : 'Road tire';
        tireCopy.textContent = changed
          ? 'More edges and open channels: a practical first experiment for a loose or changeable surface.'
          : 'Known, predictable, and already on the car. The reference point.';
      });

      const lineData = {
        early: ['EARLY APEX', 'You reach the inside too soon. The road runs out just as you want to accelerate.', [307, 280]],
        geometric: ['GEOMETRIC APEX', 'A balanced arc: useful when entry and exit matter about equally.', [339, 248]],
        late: ['LATE APEX', 'Wait, rotate, then open the wheel. The straighter exit rewards earlier acceleration.', [384, 220]]
      };
      const lineButtons = [...document.querySelectorAll('.line-button')];
      const raceLines = [...document.querySelectorAll('.race-line')];
      const lineVerdict = document.getElementById('lineVerdict');
      const lineExplanation = document.getElementById('lineExplanation');
      const apexPin = document.getElementById('apexPin');
      const carDot = document.getElementById('carDot');

      lineButtons.forEach((button) => button.addEventListener('click', () => {
        const choice = button.dataset.choice;
        lineButtons.forEach((b) => b.classList.toggle('active', b === button));
        raceLines.forEach((line) => line.classList.toggle('active', line.dataset.line === choice));
        const [verdict, explanation, pin] = lineData[choice];
        lineVerdict.textContent = verdict;
        lineExplanation.textContent = explanation;
        apexPin.setAttribute('transform', `translate(${pin[0]} ${pin[1]})`);
        carDot.animate(
          [{ transform: 'translate(0, 0)' }, { transform: 'translate(0, -110px)' }, { transform: 'translate(120px, -260px)' }],
          { duration: 900, easing: 'cubic-bezier(.4,0,.2,1)' }
        );
      }));

      const slider = document.getElementById('inputSlider');
      const inputLabel = document.getElementById('inputLabel');
      const transferViz = document.getElementById('transferViz');
      const frontPct = document.getElementById('frontPct');
      const rearPct = document.getElementById('rearPct');

      function updateTransfer() {
        const value = Number(slider.value);
        const front = Math.round(50 - value * .16);
        const rear = 100 - front;
        frontPct.textContent = String(front);
        rearPct.textContent = String(rear);
        inputLabel.textContent = value < -8 ? 'BRAKING' : value > 8 ? 'ACCELERATING' : 'COAST';
        transferViz.style.setProperty('--front-load', String(front / 50));
        transferViz.style.setProperty('--rear-load', String(rear / 50));
        transferViz.style.setProperty('--pitch', `${value * .025}deg`);
        slider.style.setProperty('--slider-fill', `${(value + 100) / 2}%`);
      }
      slider.addEventListener('input', updateTransfer);
      updateTransfer();

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('seen');
          });
        }, { threshold: .13 });
        document.querySelectorAll('.chapter-copy, .classroom > *, .course-copy, .lesson-head, .transfer-copy, .finale > *')
          .forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: Mono; src: url('/fonts/jetbrains-mono-latin-wght-normal.woff2') format('woff2'); font-display: swap; }
  :root {
    --ink: #151719;
    --paper: #f3f1eb;
    --red: #df2e22;
    --muted: #72716c;
    --line: rgba(21, 23, 25, .16);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--ink); overflow-x: hidden; }
  body { margin: 0; color: var(--ink); background: var(--paper); font-family: Inter, system-ui, sans-serif; overflow-x: hidden; }
  button, input { font: inherit; }
  .progress { position: fixed; inset: 0 0 auto; height: 3px; background: rgba(0,0,0,.08); z-index: 20; }
  .progress span { display:block; width:100%; height:100%; background:var(--red); transform:scaleX(0); transform-origin:left; }
  .site-nav { position: fixed; z-index: 15; top: 3px; left: 0; right: 0; height: 54px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 2rem; font: 600 10px/1 Mono, monospace; letter-spacing: .08em; text-transform: uppercase; mix-blend-mode: difference; color: #fff; }
  .site-nav .back { color: inherit; text-decoration: none; font-size: 17px; justify-self: start; }
  .site-nav .readout { justify-self: end; color: #aaa; }
  .hero { min-height: 100svh; padding: 15vh 5vw 5vh; display:flex; flex-direction:column; align-items:center; background:var(--paper); }
  .eyebrow, .chapter-no, .stage-label, .spec-kicker { font: 600 10px/1.2 Mono, monospace; letter-spacing:.13em; color:var(--red); }
  .hero h1, h2 { margin:0; font-weight:800; letter-spacing:-.065em; line-height:.84; text-transform:uppercase; }
  .hero h1 { font-size:clamp(72px, 12vw, 185px); text-align:center; }
  h1 em, h2 em { color:var(--red); font-style:normal; }
  .dek { max-width:630px; margin:2rem auto 0; text-align:center; font-size:clamp(16px,1.5vw,22px); line-height:1.55; }
  .hero-car { width:min(980px, 90vw); margin-top:auto; }
  .hero-car svg { display:block; width:100%; overflow:visible; }
  .shadow { fill:rgba(0,0,0,.15); }
  .car-body { fill:url(#paint); stroke:#454b4f; stroke-width:3; }
  .glass { fill:url(#glass); stroke:#1d2428; stroke-width:2; }
  .trim,.door,.scoop,.bumper { fill:none; stroke:#596064; stroke-width:3; }
  .scoop,.wing { fill:#a7adb1; }
  .wing { stroke:#454b4f; stroke-width:3; }
  .tire { fill:#141516; stroke:#303235; stroke-width:4; }
  .rim { fill:#555a5d; stroke:#d3d6d7; stroke-width:4; }
  .hub { fill:#161719; }
  .spokes { stroke:#d5d6d6; stroke-width:8; }
  .ground { stroke:var(--ink); stroke-width:2; }
  .hero-meta { width:min(900px,88vw); display:flex; justify-content:space-between; padding-top:1rem; border-top:1px solid var(--line); font:600 9px/1 Mono; letter-spacing:.1em; }
  .scroll-cue { margin-top:3vh; display:flex; align-items:center; gap:9px; font:500 9px/1 Mono; text-transform:uppercase; letter-spacing:.1em; color:var(--muted); }
  .scroll-cue span { width:28px; height:1px; background:var(--red); animation:pulse 1.8s infinite; transform-origin:left; }
  @keyframes pulse { 50% { transform:scaleX(.35); } }

  .chapter { min-height:180vh; display:grid; grid-template-columns:1fr 1fr; background:#101214; color:#f3f1eb; }
  .chapter-copy { padding:22vh 8vw; align-self:start; position:sticky; top:0; opacity:.25; transform:translateY(40px); transition:.8s; }
  .chapter-copy.seen { opacity:1; transform:none; }
  .chapter h2, .classroom h2, .course-intro h2, .lesson h2, .transfer h2, .finale h2 { margin:1.6rem 0 2rem; font-size:clamp(48px,7vw,110px); }
  .chapter-copy p, .course-copy p, .lesson-head p, .transfer-copy p, .finale p { max-width:590px; font-size:clamp(17px,1.4vw,21px); line-height:1.65; color:#b4b3ae; }
  .sticky-stage { height:100vh; position:sticky; top:0; display:flex; flex-direction:column; justify-content:center; align-items:center; padding:8vh 7vw; border-left:1px solid rgba(255,255,255,.13); }
  .stage-label { margin-bottom:1rem; }
  .wheel-demo { appearance:none; border:0; background:transparent; color:inherit; width:min(520px,44vw); cursor:pointer; padding:0; }
  .wheel-demo svg { width:100%; display:block; overflow:visible; transition:transform .7s cubic-bezier(.2,.8,.2,1); }
  .wheel-demo:hover svg { transform:rotate(8deg) scale(1.02); }
  .tire-outer { fill:#17191b; stroke:#3b3e41; stroke-width:5; }
  .tire-inner { fill:#0d0e0f; }
  .rim-large { fill:#4b5054; stroke:#d1d4d5; stroke-width:5; }
  .rim-center { fill:#151719; stroke:#aeb2b4; stroke-width:4; }
  .rim-spokes { stroke:#d3d5d5; stroke-width:16; stroke-linecap:round; }
  .tread { fill:none; stroke:#767a7d; stroke-width:13; stroke-linecap:round; transition:opacity .4s; }
  .weather-tread { stroke:var(--red); opacity:0; }
  .wheel-demo.changed .road-tread { opacity:0; }
  .wheel-demo.changed .weather-tread { opacity:1; }
  .wheel-demo.changed svg { transform:rotate(18deg); }
