---
interface Props {
  type: 'bar' | 'line' | 'pie' | 'doughnut' | 'radar' | 'scatter';
  labels: string[];
  datasets: {
    label: string;
    data: number[];
    backgroundColor?: string | string[];
    borderColor?: string | string[];
    borderWidth?: number;
    fill?: boolean;
    tension?: number;
  }[];
  title?: string;
}

const { type, labels, datasets, title } = Astro.props;
const chartId = `chart-${Math.random().toString(36).slice(2, 9)}`;
const configData = { type, data: { labels, datasets }, title: title || null,
  hasScales: type !== 'pie' && type !== 'doughnut' && type !== 'radar' };
const configJson = JSON.stringify(configData);
---

<div class="chart-container">
  <canvas id={chartId}></canvas>
</div>

<script define:vars={{ chartId, configJson }}>
  async function initChart() {
    const { Chart, registerables } = await import('chart.js');
    Chart.register(...registerables);
    const ctx = document.getElementById(chartId);
    const cd = JSON.parse(configJson);
    const style = getComputedStyle(document.documentElement);
    const fg = style.getPropertyValue('--text').trim() || '#1a1a1a';
    const muted = style.getPropertyValue('--text-muted').trim() || '#555';
    const grid = style.getPropertyValue('--border').trim() || '#e0e0db';
    const options = {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: { labels: { font: { family: 'Inter, sans-serif', size: 13 }, color: fg } },
        title: cd.title ? { display: true, text: cd.title, font: { family: 'Inter, sans-serif', size: 16, weight: 800 }, color: fg } : { display: false },
      },
      scales: cd.hasScales ? {
        x: { ticks: { font: { family: 'Inter, sans-serif' }, color: muted }, grid: { color: grid } },
        y: { ticks: { font: { family: 'Inter, sans-serif' }, color: muted }, grid: { color: grid } },
      } : undefined,
    };
    new Chart(ctx, { type: cd.type, data: cd.data, options });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChart);
  } else {
    initChart();
  }
</script>
