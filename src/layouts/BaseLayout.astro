---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'A blog by Dustin Landers.', image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Shared site-wide pageview beacon (whole domain, not just the blog). -->
    <script is:inline src="/beacon.js"></script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header>
      <nav>
        <a href="/" class="site-title">dustinlanders.com</a>
        <div class="nav-links">
          <a href="/posts">Posts</a>
          <a href="/library">Library</a>
        </div>
        <img class="header-mark" src="/images/antler-mark.png?v=2" width="32" height="32" alt="" />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>&copy; {new Date().getFullYear()} dustinlanders.com</footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    padding: 0.5rem 1rem;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 200;
    border: none;
  }

  .skip-link:focus {
    left: 0;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.5rem;
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    border: none;
    margin-right: auto;
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
  }

  .nav-links a {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border: none;
    color: var(--fg-muted);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  .header-mark {
    flex-shrink: 0;
    margin: 0;
    border: none;
  }

  @media (max-width: 480px) {
    .site-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    min-height: 60vh;
  }

  footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--fg-muted);
    text-align: center;
  }
</style>
