---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource-variable/jetbrains-mono';

const githubUrl = 'https://github.com/consolecowboy0/iracing-mcp-server';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Falcon. Open tools for connecting iRacing telemetry to AI."
    />
    <title>Falcon | iRacing race intelligence</title>
    <link rel="icon" type="image/png" href="/falcon-favicon.png?v=5" />
    <script is:inline src="/beacon.js"></script>
  </head>
  <body>
    <header class="nav-shell">
      <nav aria-label="Primary navigation">
        <a href="/" class="home-link" aria-label="Back to dustinlanders.com">
          <span aria-hidden="true">←</span>
          <span>dustinlanders.com</span>
        </a>
        <a href={githubUrl} class="nav-cta" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="identity">
          <img
            class="falcon-mark"
            src="/images/falcon-mark.png?v=5"
            width="168"
            height="168"
            alt="Falcon sigil"
          />
          <div class="eyebrow"><span></span> Falcon</div>
        </div>

        <h1>Your race data.<br /><em>Now it can talk.</em></h1>
        <p class="lede">
          An open bridge between iRacing telemetry and AI. Give a voice agent live
          access to the car, the session, and the fight happening around you.
        </p>

        <div class="actions">
          <a href={githubUrl} class="button primary" target="_blank" rel="noreferrer">
            View the project
            <span aria-hidden="true">↗</span>
          </a>
          <a href="#how-it-works" class="button secondary">How it works</a>
        </div>

        <div class="status">
          <span class="status-light" aria-hidden="true"></span>
          <span><strong>Early build</strong> · Windows · Python · MIT licensed</span>
        </div>
      </section>

      <section class="telemetry-card" aria-label="Sample live telemetry">
        <div class="terminal-head">
          <div class="terminal-title">
            <span class="pulse" aria-hidden="true"></span>
            LIVE TELEMETRY
          </div>
          <span>IRACING / MCP</span>
        </div>
        <div class="telemetry-grid">
          <div class="metric speed">
            <span class="label">SPEED</span>
            <strong>247</strong>
            <span class="unit">KM/H</span>
          </div>
          <div class="metric">
            <span class="label">GEAR</span>
            <strong>6</strong>
          </div>
          <div class="metric">
            <span class="label">POSITION</span>
            <strong>P4</strong>
          </div>
          <div class="metric">
            <span class="label">GAP AHEAD</span>
            <strong>0.42</strong>
            <span class="unit">SEC</span>
          </div>
        </div>
        <div class="radio-line">
          <span class="prompt">AGENT</span>
          <p>Car ahead is losing time under braking. Gap is down two tenths this lap.</p>
        </div>
      </section>

      <section class="manifesto">
        <p class="section-label">THE IDEA</p>
        <h2>The sim already knows everything.<br />Your AI should too.</h2>
        <p>
          iRacing produces a constant stream of useful data. The iRacing MCP Server
          turns that data into tools an AI client can understand and use in real time.
          Connect a voice agent and build a spotter, engineer, strategist, narrator,
          or something nobody has named yet.
        </p>
      </section>

      <section class="feature-grid" id="how-it-works">
        <article>
          <span class="number">01</span>
          <h3>Connect</h3>
          <p>Read live telemetry from iRacing through the proven pyirsdk interface.</p>
        </article>
        <article>
          <span class="number">02</span>
          <h3>Translate</h3>
          <p>Expose speed, fuel, lap data, position, surroundings, and session context as MCP tools.</p>
        </article>
        <article>
          <span class="number">03</span>
          <h3>Build</h3>
          <p>Plug the server into ElevenLabs or another MCP client and create your own race intelligence.</p>
        </article>
      </section>

      <section class="capabilities">
        <div>
          <p class="section-label">WHAT IT SEES</p>
          <h2>Race context,<br />not just numbers.</h2>
        </div>
        <ul>
          <li><span>01</span> Live speed, RPM, gear, inputs, and fuel</li>
          <li><span>02</span> Track, weather, session, and car information</li>
          <li><span>03</span> Position, lap times, and relative gaps</li>
          <li><span>04</span> Nearby cars ahead and behind</li>
          <li><span>05</span> Live pass events for immediate reactions</li>
        </ul>
      </section>

      <section class="direction">
        <div class="direction-copy">
          <p class="section-label">BUILDING IN PUBLIC</p>
          <h2>The final shape is still open.</h2>
          <p>
            The core server is available now under the MIT license. The next question
            is what should exist around it: a better installer, hosted infrastructure,
            premium race agents, or a community-built toolkit.
          </p>
        </div>
        <div class="paths">
          <a href={githubUrl} target="_blank" rel="noreferrer">
            <span class="path-tag">FOR BUILDERS</span>
            <strong>Fork it. Test it. Break it.</strong>
            <span class="path-link">Open the repository ↗</span>
          </a>
          <a href={`${githubUrl}/issues`} target="_blank" rel="noreferrer">
            <span class="path-tag">FOR RACERS</span>
            <strong>Tell me what would help.</strong>
            <span class="path-link">Share an idea ↗</span>
          </a>
        </div>
      </section>

      <section class="closing">
        <img src="/images/falcon-mark.png?v=5" width="72" height="72" alt="" />
        <p>Make the machine legible.</p>
        <a href={githubUrl} target="_blank" rel="noreferrer">Get started on GitHub ↗</a>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Dustin Landers</span>
      <span>Falcon</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --panel: #ffffff;
    --panel-soft: #f7f7f7;
    --line: #e5e5e5;
    --ink: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #1a1a1a;
    --mono: 'JetBrains Mono Variable', monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    line-height: 1.5;
  }

  .nav-shell,
  main,
  footer {
    position: relative;
    z-index: 1;
  }

  .nav-shell {
    border-bottom: 1px solid var(--line);
  }

  nav {
    width: min(1120px, calc(100% - 40px));
    height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.78rem;
    font-family: var(--mono);
    letter-spacing: 0.04em;
    transition: color 160ms ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  .home-link {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .nav-cta {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  main {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .hero {
    max-width: 880px;
    padding: 7rem 0 5rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2.2rem;
  }

  .falcon-mark {
    width: 92px;
    height: 92px;
    object-fit: contain;
  }

  .eyebrow,
  .section-label,
  .label,
  .unit,
  .terminal-head,
  .prompt,
  .number,
  .path-tag {
    font-family: var(--mono);
  }

  .eyebrow {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .eyebrow span {
    width: 26px;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    font-size: clamp(3.4rem, 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
    font-weight: 600;
  }

  h1 em {
    color: var(--muted);
    font-style: normal;
  }

  .lede {
    max-width: 680px;
    margin-top: 2rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.3rem;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 1.1rem;
    border-radius: 4px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .button.primary {
    background: var(--ink);
    color: var(--bg);
  }

  .button.secondary {
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .status {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .status strong {
    color: var(--ink);
    font-weight: 500;
  }

  .status-light,
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .telemetry-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .terminal-head {
    height: 48px;
    padding: 0 1.2rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .terminal-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
  }

  .pulse {
    animation: signal 1.8s ease-in-out infinite;
  }

  @keyframes signal {
    50% { opacity: 0.35; }
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
  }

  .metric {
    min-height: 138px;
    padding: 1.25rem;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .metric:last-child {
    border-right: 0;
  }

  .metric .label {
    margin-bottom: auto;
    color: var(--muted);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }

  .metric strong {
    font-family: var(--mono);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1;
  }

  .metric.speed strong {
    color: var(--ink);
  }

  .unit {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.56rem;
  }

  .radio-line {
    padding: 1rem 1.2rem;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 1rem;
    align-items: baseline;
    background: var(--panel-soft);
  }

  .prompt {
    color: var(--ink);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .radio-line p {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .manifesto {
    max-width: 840px;
    padding: 10rem 0 6rem;
  }

  .section-label {
    color: var(--ink);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    margin-bottom: 1.3rem;
  }

  h2 {
    color: var(--ink);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .manifesto > p:last-child,
  .direction-copy > p:last-child {
    max-width: 700px;
    margin-top: 1.8rem;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .feature-grid article {
    min-height: 260px;
    padding: 2rem;
    border-right: 1px solid var(--line);
  }

  .feature-grid article:first-child {
    padding-left: 0;
  }

  .feature-grid article:last-child {
    border-right: 0;
  }

  .number {
    display: block;
    margin-bottom: 4rem;
    color: var(--muted);
    font-size: 0.65rem;
  }

  h3 {
    margin-bottom: 0.8rem;
    font-size: 1.15rem;
    font-weight: 500;
  }

  .feature-grid p {
    color: var(--muted);
    font-size: 0.87rem;
    line-height: 1.7;
  }

  .capabilities {
    padding: 9rem 0;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 7rem;
    align-items: start;
  }

  .capabilities ul {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .capabilities li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.9rem;
  }

  .capabilities li span {
    display: inline-block;
    width: 3rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.62rem;
  }

  .direction {
    padding: 4.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
  }

  .direction-copy {
    max-width: 720px;
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .paths a {
    min-height: 180px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 5px;
    color: var(--ink);
    text-decoration: none;
    background: var(--bg);
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }

  .paths a:hover {
    transform: translateY(-3px);
    border-color: var(--ink);
    background: var(--panel-soft);
  }

  .path-tag {
    color: var(--ink);
    font-size: 0.58rem;
    letter-spacing: 0.13em;
  }

  .paths strong {
    margin-top: 1.1rem;
    font-size: 1.2rem;
    font-weight: 500;
  }

  .path-link {
    margin-top: auto;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .closing {
    padding: 10rem 0 8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .closing img {
    width: 72px;
    height: 72px;
    margin-bottom: 1.5rem;
  }

  .closing p {
    margin-bottom: 1rem;
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.045em;
  }

  .closing a {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-decoration: none;
  }

  footer {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 4.5rem;
    }

    .identity {
      align-items: flex-start;
      flex-direction: column;
    }

    .telemetry-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .metric {
      min-height: 120px;
      border-bottom: 1px solid var(--line);
    }

    .metric:nth-child(2) {
      border-right: 0;
    }

    .metric:nth-child(3),
    .metric:nth-child(4) {
      border-bottom: 0;
    }

    .radio-line {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .manifesto {
      padding: 7rem 0 4rem;
    }

    .feature-grid,
    .capabilities,
    .paths {
      grid-template-columns: 1fr;
    }

    .feature-grid article,
    .feature-grid article:first-child {
      min-height: 0;
      padding: 2rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .feature-grid article:last-child {
      border-bottom: 0;
    }

    .number {
      margin-bottom: 2rem;
    }

    .capabilities {
      padding: 7rem 0;
      gap: 3rem;
    }

    .direction {
      padding: 2.25rem 1.25rem;
    }

    footer {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .pulse {
      animation: none;
    }
  }
</style>
