---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Analytics - dustinlanders.com">
  <div id="gate">
    <div class="gate-box">
      <div class="gate-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2>Analytics</h2>
      <p class="gate-sub">Enter password to continue.</p>
      <form id="gate-form">
        <input type="password" id="gate-password" placeholder="Password" autocomplete="off" />
        <button type="submit" id="gate-unlock">Unlock</button>
      </form>
      <p id="gate-error" class="gate-error gate-hidden">Wrong password</p>
    </div>
  </div>

  <section id="panel" style="display: none;">
    <div class="dash-header">
      <div>
        <h1>Where visitors come from</h1>
        <p class="dash-tagline">Channels, sources, geography, and campaigns.</p>
      </div>
      <div class="dash-controls">
        <label class="owner-toggle"><input type="checkbox" id="owner-include" /> Include my visits</label>
        <select id="range-select">
          <option value="1h">Last 1 hour</option>
          <option value="12h">Last 12 hours</option>
          <option value="24h">Last 24 hours</option>
          <option value="7">Last 7 days</option>
          <option value="30" selected>Last 30 days</option>
          <option value="90">Last 90 days</option>
        </select>
        <button id="sign-out" class="secondary-btn">Sign Out</button>
      </div>
    </div>

    <div id="dash-loading" class="dash-note">Loading…</div>
    <div id="dash-error" class="dash-note dash-error gate-hidden"></div>

    <div id="dash-body" class="dash-body gate-hidden">

      <!-- HERO: acquisition channels -->
      <section class="block hero-block">
        <div class="block-head">
          <h2>Acquisition channels</h2>
          <span class="block-sub" id="chan-sub"></span>
        </div>
        <div class="chan-bar-wrap"><canvas id="chan-chart" aria-hidden="true"></canvas></div>
        <div class="chan-empty dash-note gate-hidden" id="chan-empty">No qualified traffic in this range yet.</div>
        <div class="chan-strip" id="chan-strip"></div>
        <p class="cover-note" id="direct-note">
          Direct / unknown means the browser sent no source: app opens (Slack, Discord, iOS Mail), typed URLs, and links that stripped their referrer. Tag shared links with <code>?utm_source=</code> to reclaim them.
        </p>
        <table class="sr-only" id="chan-sr">
          <caption>Acquisition channels</caption>
          <thead><tr><th>Channel</th><th>Visitors</th><th>Views</th><th>Share</th></tr></thead>
          <tbody></tbody>
        </table>
      </section>

      <!-- WHERE: sources + geography -->
      <div class="where-grid">
        <section class="block">
          <div class="block-head"><h2>Top sources</h2><span class="block-sub" id="src-sub"></span></div>
          <table class="lead-table">
            <thead><tr><th>Source</th><th class="num">Visitors</th><th class="num">Views</th></tr></thead>
            <tbody id="sources-body"></tbody>
          </table>
          <p id="sources-empty" class="dash-note gate-hidden">No sources yet.</p>
        </section>

        <section class="block">
          <div class="block-head"><h2>Geography</h2><span class="block-sub" id="geo-sub"></span></div>
          <div id="geo-list" class="geo-list"></div>
          <p id="geo-empty" class="dash-note gate-hidden">No geography recorded yet.</p>
          <div id="region-wrap" class="region-wrap gate-hidden">
            <h3 id="region-title">Top regions</h3>
            <div id="region-list" class="geo-list"></div>
          </div>
          <div id="city-wrap" class="region-wrap gate-hidden">
            <h3 id="city-title">Top cities</h3>
            <div id="city-list" class="geo-list"></div>
          </div>
          <p class="cover-note" id="geo-cover"></p>
        </section>
      </div>

      <!-- Source -> city cross-tab -->
      <section class="block" id="srccity-block">
        <div class="block-head">
          <h2>Cities by source</h2>
          <select id="srccity-select" class="src-city-select"></select>
        </div>
        <div id="srccity-list" class="geo-list"></div>
        <p id="srccity-empty" class="dash-note gate-hidden">No located traffic for this source yet.</p>
      </section>

      <!-- Campaigns -->
      <section class="block" id="campaign-block">
        <div class="block-head"><h2>Campaigns</h2><span class="block-sub">UTM-tagged links</span></div>
        <table class="lead-table" id="campaign-table">
          <thead><tr><th>Campaign</th><th>Source / medium</th><th class="num">Visitors</th><th class="num">Views</th></tr></thead>
          <tbody id="campaign-body"></tbody>
        </table>
        <div id="campaign-empty" class="empty-card gate-hidden">
          <p>No campaign-tagged traffic yet. Add UTM params to links you share, then they show up here:</p>
          <code>?utm_source=newsletter&amp;utm_medium=email&amp;utm_campaign=may-digest</code>
        </div>
      </section>

      <!-- Trend (demoted) -->
      <section class="block">
        <div class="block-head">
          <h2>Traffic over time</h2>
          <label class="stack-toggle"><input type="checkbox" id="stack-toggle" /> Stack by channel</label>
        </div>
        <div class="chart-wrap"><canvas id="trend-chart"></canvas></div>
        <p class="cover-note gate-hidden" id="epoch-note"></p>
      </section>

      <!-- Volume + pages (demoted) -->
      <div class="bottom-grid">
        <div class="stat-cards">
          <div class="stat-card">
            <div class="stat-label">Pageviews</div>
            <div class="stat-value" id="stat-views">—</div>
          </div>
          <div class="stat-card">
            <div class="stat-label" title="Unique per UTC day, summed over the window. Returning readers count once per day.">Daily visits</div>
            <div class="stat-value" id="stat-visitors">—</div>
          </div>
          <div class="stat-card owner-card">
            <div class="stat-label">Your visits</div>
            <button id="mark-owner" class="secondary-btn">This is me</button>
            <p class="owner-hint" id="owner-hint">Tag this browser so its visits drop out of the breakdowns.</p>
          </div>
        </div>
        <section class="block">
          <div class="block-head"><h2>Top pages</h2></div>
          <table class="lead-table"><tbody id="paths-body"></tbody></table>
        </section>
      </div>

      <!-- Subscribers (editable) -->
      <section class="block" id="subs-block">
        <div class="block-head"><h2>Subscribers</h2><span class="block-sub" id="subs-sub"></span></div>
        <form id="subs-add-form" class="subs-add">
          <input type="email" id="subs-add-email" placeholder="name@example.com" autocomplete="off" />
          <button type="submit" class="secondary-btn">Add</button>
        </form>
        <p id="subs-error" class="subs-error gate-hidden"></p>
        <div id="subs-loading" class="dash-note">Loading…</div>
        <table class="lead-table" id="subs-table">
          <thead><tr><th>Email</th><th>Source</th><th class="num">Joined</th><th class="num">Actions</th></tr></thead>
          <tbody id="subs-body"></tbody>
        </table>
        <p id="subs-empty" class="dash-note gate-hidden">No subscribers yet.</p>
      </section>

    </div>
  </section>
</BaseLayout>

<style>
  #gate {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50vh;
  }
  .gate-box { text-align: center; max-width: 320px; width: 100%; }
  .gate-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: var(--code-bg); color: var(--fg-muted);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;
  }
  .gate-box h2 { margin-top: 0; margin-bottom: 0.2rem; font-size: 1.25rem; }
  .gate-sub { color: var(--fg-muted); font-size: 0.8rem; margin-bottom: 1.25rem; }
  #gate-form { display: flex; gap: 0.4rem; }
  #gate-password {
    flex: 1; padding: 0.55rem 0.85rem; border: 1px solid var(--border);
    border-radius: 10px; background: var(--bg); color: var(--fg);
    font-family: var(--font-mono); font-size: 0.84rem; outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  #gate-password:focus {
    border-color: var(--fg-muted);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fg-muted) 10%, transparent);
  }
  #gate-form button {
    padding: 0.55rem 1.25rem; background: var(--fg); color: var(--bg);
    border: none; border-radius: 10px; font-family: var(--font-body);
    font-size: 0.84rem; font-weight: 600; cursor: pointer; transition: opacity 0.15s;
  }
  #gate-form button:hover { opacity: 0.85; }
  .gate-error { color: #e54; font-size: 0.78rem; margin-top: 0.75rem; }
  .gate-hidden { display: none !important; }

  .dash-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem;
  }
  .dash-header h1 { margin: 0; font-size: 1.5rem; }
  .dash-tagline { margin: 0.2rem 0 0; color: var(--fg-muted); font-size: 0.82rem; }
  .dash-controls { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .owner-toggle { display: flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; color: var(--fg-muted); }
  #range-select {
    padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 0.82rem;
  }
  .secondary-btn {
    padding: 0.4rem 0.9rem; background: transparent; color: var(--fg);
    border: 1px solid var(--border); border-radius: 8px; font-family: var(--font-body);
    font-size: 0.82rem; cursor: pointer;
  }
  .secondary-btn:hover { background: var(--code-bg); }

  .dash-note { color: var(--fg-muted); font-size: 0.85rem; padding: 0.5rem 0; }
  .dash-error { color: #e54; }

  /* Channel palette. Every color is paired with a text label in the UI. */
  .dash-body {
    --ch-search: #2563eb;
    --ch-social: #db2777;
    --ch-email: #d97706;
    --ch-referral: #059669;
    --ch-direct: #6b7280;
    --ch-other: #9ca3af;
  }
  :global([data-theme="dark"]) .dash-body {
    --ch-search: #60a5fa; --ch-social: #f472b6; --ch-email: #fbbf24;
    --ch-referral: #34d399; --ch-direct: #9ca3af; --ch-other: #6b7280;
  }
  :global([data-theme="rainbow"]) .dash-body {
    --ch-search: #4ad9ff; --ch-social: #ff6ec7; --ch-email: #ffd166;
    --ch-referral: #2ff0d6; --ch-direct: #c0a0ff; --ch-other: #9a86c8;
  }

  .block {
    border: 1px solid var(--border); border-radius: 12px;
    padding: 1.1rem 1.25rem; background: var(--code-bg); margin-bottom: 1.25rem;
  }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.9rem; }
  .block-head h2 { margin: 0; font-size: 1.05rem; }
  .block-head h3 { margin: 0; }
  .block-sub { font-size: 0.74rem; color: var(--fg-muted); }

  /* Hero channel block sits at the top and reads largest. */
  .hero-block { background: var(--bg); }
  .chan-bar-wrap { position: relative; height: 46px; margin-bottom: 0.9rem; }
  .chan-bar-wrap canvas { width: 100% !important; height: 100% !important; }
  .chan-strip {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.6rem 1rem;
  }
  /* Channel cells, table rows, and geo rows are injected by client JS via
     innerHTML, so they never receive Astro's scoping attribute and scoped
     selectors silently miss them. Anchor each rule under the scoped .dash-body
     wrapper and mark the dynamic part :global so it still applies to JS-built
     nodes (without leaking these classes site-wide). */
  .dash-body :global(.chan-cell) {
    border-left: 3px solid var(--c, var(--border)); padding: 0.1rem 0 0.1rem 0.6rem;
  }
  /* Percent hugs right after the channel name (default flex-start + the 0.5rem
     gap), not flung to the far column edge where it reads as disconnected. */
  .dash-body :global(.chan-cell .chan-top) {
    display: flex; align-items: baseline; gap: 0.5rem;
  }
  .dash-body :global(.chan-cell .chan-name) { font-size: 0.82rem; font-weight: 600; }
  .dash-body :global(.chan-cell .chan-pct) { font-size: 0.82rem; font-weight: 800; font-family: var(--font-mono); }
  .dash-body :global(.chan-cell .chan-count) { font-size: 0.68rem; color: var(--fg-muted); font-family: var(--font-mono); }

  .where-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (max-width: 760px) { .where-grid { grid-template-columns: 1fr; } }

  .lead-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .lead-table thead th {
    text-align: left; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--fg-muted); font-weight: 600; padding: 0 0.5rem 0.35rem; border-bottom: 1px solid var(--border);
  }
  .dash-body :global(.lead-table th.num), .dash-body :global(.lead-table td.num) { text-align: right; }
  .dash-body :global(.lead-table td) {
    padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border);
    font-family: var(--font-mono); vertical-align: middle;
  }
  .dash-body :global(.lead-table td.num) { color: var(--fg-muted); white-space: nowrap; }
  .dash-body :global(.lead-table td.muted) { color: var(--fg-muted); }
  .dash-body :global(.lead-table tr:last-child td) { border-bottom: none; }

  /* In-row bar behind the source name. */
  .dash-body :global(.bar-cell) { position: relative; max-width: 0; width: 100%; }
  .dash-body :global(.bar-cell .bar) {
    position: absolute; left: 0; top: 3px; bottom: 3px; border-radius: 4px;
    opacity: 0.16; z-index: 0;
  }
  .dash-body :global(.bar-cell .lead-label), .dash-body :global(.bar-cell .ch-chip) { position: relative; z-index: 1; }
  .dash-body :global(.bar-cell .lead-label) {
    display: inline-block; max-width: calc(100% - 4.5rem); overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; vertical-align: middle;
  }
  .dash-body :global(.ch-chip) {
    display: inline-block; margin-left: 0.4rem; padding: 0.02rem 0.4rem; border-radius: 6px;
    font-size: 0.6rem; font-weight: 700; color: #fff; text-transform: uppercase;
    letter-spacing: 0.03em; vertical-align: middle; font-family: var(--font-body);
  }
  .dash-body :global(.row-other td) { color: var(--fg-muted); font-style: italic; }

  /* Geography ranked bar list. */
  .geo-list { display: flex; flex-direction: column; gap: 0.45rem; }
  .dash-body :global(.geo-row) { display: grid; grid-template-columns: 1.4rem 1fr 2.6rem; align-items: center; gap: 0.5rem; font-size: 0.82rem; }
  .dash-body :global(.geo-flag) { font-size: 1rem; line-height: 1; }
  .dash-body :global(.geo-mid) { min-width: 0; }
  .dash-body :global(.geo-name) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 0.2rem; }
  .dash-body :global(.geo-track) { height: 0.5rem; border-radius: 4px; background: var(--border); overflow: hidden; }
  .dash-body :global(.geo-bar) { height: 100%; border-radius: 4px; background: var(--ch-referral); }
  .dash-body :global(.geo-count) { text-align: right; font-family: var(--font-mono); color: var(--fg-muted); font-size: 0.78rem; }
  .dash-body :global(.geo-row.muted .geo-name) { color: var(--fg-muted); font-style: italic; }
  .dash-body :global(.geo-sub) { color: var(--fg-muted); font-weight: 400; }
  .src-city-select {
    padding: 0.3rem 0.5rem; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--fg); font-family: var(--font-body);
    font-size: 0.78rem; max-width: 60%;
  }
  .region-wrap { margin-top: 1rem; padding-top: 0.85rem; border-top: 1px dashed var(--border); }
  .region-wrap h3 { font-size: 0.82rem; margin-bottom: 0.6rem; color: var(--fg-muted); }

  .empty-card {
    border: 1px dashed var(--border); border-radius: 10px; padding: 0.9rem 1rem;
    font-size: 0.82rem; color: var(--fg-muted);
  }
  .empty-card code, .cover-note code {
    background: var(--code-bg); padding: 0.1rem 0.35rem; border-radius: 5px;
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--fg);
  }
  .empty-card code { display: inline-block; margin-top: 0.5rem; background: var(--bg); }

  .cover-note { font-size: 0.7rem; color: var(--fg-muted); margin: 0.7rem 0 0; line-height: 1.5; }

  .chart-wrap { position: relative; height: 280px; }
  .chart-wrap canvas { width: 100% !important; height: 100% !important; }
  .stack-toggle { display: flex; align-items: center; gap: 0.35rem; font-size: 0.76rem; color: var(--fg-muted); }

  .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: start; }
  @media (max-width: 760px) { .bottom-grid { grid-template-columns: 1fr; } }
  .stat-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .stat-card {
    border: 1px solid var(--border); border-radius: 12px;
    padding: 0.9rem 1rem; background: var(--code-bg);
  }
  .owner-card { grid-column: span 2; display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  .owner-card .stat-label { margin-bottom: 0.1rem; }
  .owner-hint { margin: 0; font-size: 0.7rem; color: var(--fg-muted); }
  .stat-label { font-size: 0.72rem; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .stat-value { font-size: 1.8rem; font-weight: 800; margin-top: 0.2rem; font-family: var(--font-mono); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  /* Subscribers block */
  .subs-add { display: flex; gap: 0.4rem; margin-bottom: 0.6rem; }
  .subs-add input {
    flex: 1; padding: 0.45rem 0.7rem; border: 1px solid var(--border);
    border-radius: 8px; background: var(--bg); color: var(--fg);
    font-family: var(--font-mono); font-size: 0.8rem; outline: none;
    transition: border-color 0.15s;
  }
  .subs-add input:focus { border-color: var(--fg-muted); }
  .subs-error { color: #e54; font-size: 0.76rem; margin: 0 0 0.6rem; }
  .subs-actions { display: flex; gap: 0.35rem; justify-content: flex-end; }
  .subs-btn {
    padding: 0.2rem 0.55rem; background: transparent; color: var(--fg-muted);
    border: 1px solid var(--border); border-radius: 6px; font-family: var(--font-body);
    font-size: 0.72rem; cursor: pointer; transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .subs-btn:hover { background: var(--bg); color: var(--fg); }
  .subs-btn.danger:hover { color: #e54; border-color: #e54; }
  .subs-edit-input {
    width: 100%; padding: 0.25rem 0.4rem; border: 1px solid var(--fg-muted);
    border-radius: 6px; background: var(--bg); color: var(--fg);
    font-family: var(--font-mono); font-size: 0.8rem; outline: none;
  }

  /* Phones: two 150px channel cells don't fit, so names wrap and the percent
     floats off. Drop to one column, tighten chrome, let controls fill width. */
  @media (max-width: 560px) {
    .block { padding: 1rem 1rem; }
    .dash-header h1 { font-size: 1.3rem; }
    .dash-controls { width: 100%; }
    .owner-toggle { order: 3; }
    #range-select { flex: 1; }
    #sign-out { margin-left: auto; }

    .chan-strip { grid-template-columns: 1fr; gap: 0.55rem; }
    .dash-body :global(.chan-cell .chan-top) { justify-content: space-between; }

    .stat-cards { grid-template-columns: 1fr; }
    .owner-card { grid-column: auto; }

    /* Subscribers table is dense: hide the Source column on narrow screens. */
    #subs-table th:nth-child(2), #subs-table td:nth-child(2) { display: none; }
  }
</style>

<script>
  import '../../lib/analytics-dashboard.ts';
</script>
