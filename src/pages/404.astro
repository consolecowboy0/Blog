---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not Found · dustinlanders.com" description="Page not found.">
  <div class="not-found">
    <h1>404</h1>
    <p>This page doesn't exist.</p>
    <nav class="not-found-nav">
      <a href="/">Home</a>
      <a href="/posts">Posts</a>
      <a href="/library">Library</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 6rem 1rem;
  }

  .not-found h1 {
    font-size: 4rem;
    font-family: var(--font-mono);
    margin: 0 0 0.5rem;
  }

  .not-found p {
    color: var(--fg-muted);
    margin-bottom: 2rem;
  }

  .not-found-nav {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .not-found-nav a {
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
